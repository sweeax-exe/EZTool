<Application x:Class="EZTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:EZTool.Core"
>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <core:BytesConverter x:Key="Bytes" />
            <core:BoolToVisibilityConverter x:Key="Vis" />
            <core:BoolToVisibilityConverter x:Key="InvVis" Invert="True" />
            <core:AgeConverter x:Key="Age" />
            <core:EqualsConverter x:Key="Eq" />
            <core:NotConverter x:Key="Not" />
            <core:NameToBrushConverter x:Key="NameBrush" />
            <core:AnyVisibleConverter x:Key="AnyVis" />
            <core:InitialConverter x:Key="Initial" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

