<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:EZTool.Controls">

    <c:TempToBrushConverter x:Key="TempBrush" />
    <c:PercentToLengthConverter x:Key="PctLen" />

    <!-- Messkanal: links ausgerichtet wie die Beschriftung an einem Messgerät.
         Der Farbstreifen oben ist die Kanalfarbe und zugleich die Legende für den Live-Verlauf. -->
    <Style TargetType="c:GaugeCard">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="22,18,22,20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:GaugeCard">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <Border Width="22" Height="4" HorizontalAlignment="Left" Background="{TemplateBinding ArcBrush}" Margin="0,0,0,10" />
                                <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource H2}" FontSize="15" />
                                <TextBlock Text="{TemplateBinding Caption}" Style="{StaticResource Label}" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" ToolTip="{TemplateBinding Caption}" />
                            </StackPanel>

                            <!-- Großer Wert, rechts daneben der Zweitwert (z. B. Temperatur) -->
                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <TextBlock Text="{TemplateBinding ValueText}" FontFamily="{StaticResource DisplayFont}" FontSize="76" FontWeight="SemiBold"
                                               FontStretch="Condensed" Typography.NumeralAlignment="Tabular" Foreground="{StaticResource Text}"
                                               LineStackingStrategy="BlockLineHeight" LineHeight="70" />
                                    <TextBlock Text="{TemplateBinding Unit}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontStretch="Condensed"
                                               Foreground="{StaticResource TextMute}" VerticalAlignment="Bottom" Margin="4,0,0,8" />
                                </StackPanel>
                                <TextBlock x:Name="sub" Text="{TemplateBinding SubText}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontStretch="SemiCondensed"
                                           Foreground="{TemplateBinding SubBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                            </Grid>

                            <c:SegmentMeter Grid.Row="2" Height="14" Margin="0,10,0,0" Segments="32" WarnAt="80" HotAt="94"
                                            Value="{TemplateBinding Value}" Brush="{TemplateBinding ArcBrush}" />

                            <Grid Grid.Row="4" Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{TemplateBinding Stat1Label}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{TemplateBinding Stat1Value}" Style="{StaticResource Value}" FontSize="17" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{TemplateBinding Stat2Label}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{TemplateBinding Stat2Value}" Style="{StaticResource Value}" FontSize="17" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SubBrush" Value="{x:Null}">
                            <Setter TargetName="sub" Property="Foreground" Value="{StaticResource TextDim}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
