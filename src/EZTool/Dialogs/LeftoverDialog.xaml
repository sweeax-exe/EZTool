<Window x:Class="EZTool.Dialogs.LeftoverDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:EZTool.Core"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" Width="760" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource BodyFont}" UseLayoutRounding="True">
    <Border Margin="24" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource Rule}"
            Background="{StaticResource Panel}" Effect="{StaticResource SoftShadow}">
        <StackPanel Margin="26,24">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="4" Background="{StaticResource AccentSoft}">
                    <TextBlock Text="&#xEA99;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{l:T Leftover.Title}" Style="{StaticResource H2}" FontSize="19" />
                    <TextBlock x:Name="SubText" Style="{StaticResource Body}" FontSize="12" />
                </StackPanel>
            </StackPanel>

            <TextBlock Style="{StaticResource Body}" FontSize="12.5" Margin="0,16,0,0" LineHeight="19" Text="{l:T Leftover.Info}" />

            <Border Margin="0,14,0,0" CornerRadius="4" Background="{StaticResource Well}" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1" MaxHeight="340">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,6">
                    <ItemsControl x:Name="List">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked}" />
                                    <Border Grid.Column="1" Style="{StaticResource Chip}" Margin="12,0,10,0" Padding="7,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Kind}" FontSize="10.5" Foreground="{StaticResource Accent}" FontFamily="{StaticResource DisplayFont}" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Path}" Foreground="{StaticResource Text}" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Path}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Size, Converter={StaticResource Bytes}}" Foreground="{StaticResource TextDim}"
                                               FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Style="{StaticResource GhostButton}" Content="{l:T Leftover.Keep}" Click="Cancel_Click" Margin="0,0,10,0" IsCancel="True" />
                <Button Style="{StaticResource PrimaryButton}" Content="{l:T Leftover.RemoveSelected}" Click="Confirm_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
