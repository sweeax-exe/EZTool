<Window x:Class="EZTool.Dialogs.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        SizeToContent="WidthAndHeight" FontFamily="{StaticResource DisplayFont}" UseLayoutRounding="True"
        Title="EZTool Overlay">
    <Border x:Name="Panel" CornerRadius="4" Padding="14,10" BorderThickness="1" Margin="8" Background="#E6181A1D" BorderBrush="#FF3A3F45">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.5" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" MinWidth="54" />
                <ColumnDefinition Width="Auto" MinWidth="54" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="FpsLabel" Grid.Row="3" Text="FPS" Foreground="{StaticResource Amber}" FontSize="12" FontWeight="SemiBold" Margin="0,4,14,1" Visibility="Collapsed" />
            <TextBlock x:Name="FpsValue" Grid.Row="3" Grid.Column="1" Text="" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,3,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="FrameTime" Grid.Row="3" Grid.Column="2" Text="" Foreground="{StaticResource TextDim}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" />

            <TextBlock Text="CPU" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold" Margin="0,1,14,1" />
            <TextBlock x:Name="CpuLoad" Grid.Column="1" Text="—" Foreground="White" FontSize="13" HorizontalAlignment="Right" />
            <TextBlock x:Name="CpuTemp" Grid.Column="2" Text="" Foreground="{StaticResource TextDim}" FontSize="13" HorizontalAlignment="Right" />

            <TextBlock Grid.Row="1" Text="GPU" Foreground="{StaticResource Blue}" FontSize="12" FontWeight="SemiBold" Margin="0,1,14,1" />
            <TextBlock x:Name="GpuLoad" Grid.Row="1" Grid.Column="1" Text="—" Foreground="White" FontSize="13" HorizontalAlignment="Right" />
            <TextBlock x:Name="GpuTemp" Grid.Row="1" Grid.Column="2" Text="" Foreground="{StaticResource TextDim}" FontSize="13" HorizontalAlignment="Right" />

            <TextBlock Grid.Row="2" Text="RAM" Foreground="{StaticResource Green}" FontSize="12" FontWeight="SemiBold" Margin="0,1,14,1" />
            <TextBlock x:Name="RamLoad" Grid.Row="2" Grid.Column="1" Text="—" Foreground="White" FontSize="13" HorizontalAlignment="Right" />
            <TextBlock x:Name="RamUsed" Grid.Row="2" Grid.Column="2" Text="" Foreground="{StaticResource TextDim}" FontSize="13" HorizontalAlignment="Right" />
        </Grid>
    </Border>
</Window>
