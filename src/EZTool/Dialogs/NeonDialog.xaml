<Window x:Class="EZTool.Dialogs.NeonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" Width="520" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource BodyFont}" UseLayoutRounding="True">
    <Border Margin="24" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource Rule}"
            Background="{StaticResource Panel}" Effect="{StaticResource SoftShadow}">
        <Grid Margin="26,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border x:Name="IconBorder" Width="40" Height="40" CornerRadius="4" Background="{StaticResource AccentSoft}">
                    <TextBlock x:Name="IconText" Text="&#xE946;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText" Style="{StaticResource H2}" FontSize="19" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>

            <TextBlock x:Name="MessageText" Grid.Row="1" Style="{StaticResource Body}" FontSize="13.5" Margin="0,16,0,0" LineHeight="20" />

            <Border x:Name="DetailsBorder" Grid.Row="2" Margin="0,14,0,0" CornerRadius="4" Background="{StaticResource Well}"
                    BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1" Visibility="Collapsed" MaxHeight="220">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
                    <ItemsControl x:Name="DetailsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource Text}" FontSize="12.5" Margin="0,3" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Click="Cancel_Click" Margin="0,0,10,0" IsCancel="True" />
                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Click="Confirm_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
