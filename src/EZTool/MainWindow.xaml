<Window x:Class="EZTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:EZTool.Core"
        Title="EZTool" Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Chassis}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource BodyFont}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" Icon="Assets/app.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="{StaticResource Chassis}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════ Sidebar: bündige, dunklere Schiene ═══════ -->
        <Border Grid.Column="0" Background="{StaticResource Rail}">
            <DockPanel>
                <!-- Marke "Pegel": vier gelbe Pegelbalken und ein roter Spitzenbalken, pixelgenau auf 34 px -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,26,0,28">
                    <Border Width="34" Height="34" CornerRadius="6" Background="{StaticResource Panel}">
                        <Canvas Width="34" Height="34">
                            <Rectangle Canvas.Left="7" Canvas.Top="22" Width="3" Height="5" Fill="{StaticResource Accent}" />
                            <Rectangle Canvas.Left="11" Canvas.Top="18" Width="3" Height="9" Fill="{StaticResource Accent}" />
                            <Rectangle Canvas.Left="15" Canvas.Top="15" Width="3" Height="12" Fill="{StaticResource Accent}" />
                            <Rectangle Canvas.Left="19" Canvas.Top="12" Width="3" Height="15" Fill="{StaticResource Accent}" />
                            <Rectangle Canvas.Left="23" Canvas.Top="7" Width="3" Height="20" Fill="{StaticResource Red}" />
                        </Canvas>
                    </Border>
                    <TextBlock Text="EZTool" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="22"
                               Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <!-- Mini-Monitor + Status -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource PanelHi}" BorderThickness="0,1,0,0">
                <StackPanel Margin="24,18,22,20">
                    <Button x:Name="UpdateBadge" Style="{StaticResource PrimaryButton}" Padding="12,8" FontSize="12.5"
                            Margin="0,0,0,18" Visibility="Collapsed" Click="UpdateBadge_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                            <TextBlock x:Name="UpdateBadgeText" Text="{l:T Shell.UpdateAvailableShort}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Grid>
                        <TextBlock Text="CPU" Style="{StaticResource Label}" />
                        <TextBlock x:Name="MiniCpu" Text="—" HorizontalAlignment="Right" Style="{StaticResource Value}" FontSize="12.5" />
                    </Grid>
                    <ProgressBar x:Name="MiniCpuBar" Style="{StaticResource NeonBar}" Height="6" Margin="0,6,0,12" />
                    <Grid>
                        <TextBlock Text="RAM" Style="{StaticResource Label}" />
                        <TextBlock x:Name="MiniRam" Text="—" HorizontalAlignment="Right" Style="{StaticResource Value}" FontSize="12.5" />
                    </Grid>
                    <ProgressBar x:Name="MiniRamBar" Style="{StaticResource NeonBar}" Foreground="{StaticResource Green}" Height="6" Margin="0,6,0,0" />

                    <Grid Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="6" Height="6" Fill="{StaticResource Green}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Text="" Style="{StaticResource Label}" FontSize="11.5" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="VersionText" Text="" Style="{StaticResource Label}" FontSize="11.5" Foreground="{StaticResource TextMute}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
                </Border>

                <!-- Navigation -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,2,12">
                    <StackPanel x:Name="NavPanel" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══════ Inhalt ═══════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Titelleiste -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="{l:T Window.Minimize}" />
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="{l:T Window.Maximize}" />
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="{l:T Window.Close}" />
            </StackPanel>

            <!-- Seitenkopf -->
            <Grid Grid.Row="1" Margin="40,0,40,24">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="" Style="{StaticResource H1}" />
                    <TextBlock x:Name="PageSubtitle" Text="" Style="{StaticResource Body}" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock x:Name="ClockText" Text="" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,2"
                           Style="{StaticResource Value}" FontSize="13" Foreground="{StaticResource TextDim}" />
            </Grid>

            <ContentControl x:Name="PageHost" Grid.Row="2" Focusable="False" />
        </Grid>
    </Grid>
</Window>
