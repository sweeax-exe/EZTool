<Window x:Class="EZTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:EZTool.Core"
        Title="EZTool" Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource BodyFont}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" Icon="Assets/app.ico">
    <WindowChrome.WindowChrome>
        <!-- GlassFrameThickness=-1: DWM darf hinter dem ganzen Fenster das Acrylic-Glas rendern -->
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <!-- ═══════ Hintergrund: Tönung über dem Acrylic-Glas + treibende Aurora ═══════ -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Rectangle x:Name="Tint" Fill="#B0050913" />

            <Canvas x:Name="Aurora">
                <Ellipse Width="900" Height="700" Canvas.Left="-260" Canvas.Top="-300" Opacity="0.55">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#5500E5FF" Offset="0" />
                            <GradientStop Color="#0000E5FF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Orb1" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="1000" Height="800" Canvas.Left="700" Canvas.Top="420" Opacity="0.6">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#668B5CF6" Offset="0" />
                            <GradientStop Color="#008B5CF6" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Orb2" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="700" Height="600" Canvas.Left="900" Canvas.Top="-260" Opacity="0.35">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#55FF3D9A" Offset="0" />
                            <GradientStop Color="#00FF3D9A" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Orb3" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>

            <!-- feines Raster -->
            <Rectangle Opacity="0.8">
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,48,48" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Geometry="M0,0 L48,0 M0,0 L0,48">
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#09FFFFFF" Thickness="1" />
                                </GeometryDrawing.Pen>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
                <Rectangle.OpacityMask>
                    <RadialGradientBrush Center="0.55,0.25" RadiusX="0.75" RadiusY="0.9">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══════ Sidebar (Glas) ═══════ -->
            <Border Grid.Column="0" Margin="12,12,0,12" CornerRadius="20" BorderThickness="1"
                    Background="{StaticResource GlassPanel}" BorderBrush="{StaticResource GlassEdge}">
                <DockPanel>
                    <!-- Logo -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,24,0,26">
                        <Grid Width="42" Height="42">
                            <Path Data="M21,1 L39,11 L39,31 L21,41 L3,31 L3,11 Z" StrokeThickness="2" Stroke="{StaticResource AccentGradientDiag}"
                                  Fill="#1400E5FF" Effect="{StaticResource CyanGlow}" />
                            <TextBlock Text="EZ" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Text}" />
                        </Grid>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="Bold">
                                <Run Text="EZ" Foreground="{StaticResource Text}" /><Run Text="TOOL" Foreground="{StaticResource AccentGradient}" />
                            </TextBlock>
                            <TextBlock Text="SYSTEM CONTROL" Style="{StaticResource Label}" FontSize="9" Margin="1,-2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Mini-Monitor + Status -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,18">
                        <Button x:Name="UpdateBadge" Style="{StaticResource PrimaryButton}" Background="{StaticResource GreenGradient}" Padding="12,8" FontSize="12.5"
                                Margin="0,0,0,10" Visibility="Collapsed" Click="UpdateBadge_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                <TextBlock x:Name="UpdateBadgeText" Text="{l:T Shell.UpdateAvailableShort}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource Card}" Padding="14,12" CornerRadius="14">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="CPU" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="MiniCpu" Text="—" HorizontalAlignment="Right" FontFamily="{StaticResource DisplayFont}" FontSize="12" />
                                </Grid>
                                <ProgressBar x:Name="MiniCpuBar" Style="{StaticResource NeonBar}" Height="4" Margin="0,6,0,10" />
                                <Grid>
                                    <TextBlock Text="RAM" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="MiniRam" Text="—" HorizontalAlignment="Right" FontFamily="{StaticResource DisplayFont}" FontSize="12" />
                                </Grid>
                                <ProgressBar x:Name="MiniRamBar" Style="{StaticResource NeonBar}" Foreground="{StaticResource HotGradient}" Height="4" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="6,12,0,0">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Green}" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#2CF5A0" BlurRadius="8" ShadowDepth="0" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="StatusText" Text="" Style="{StaticResource Body}" FontSize="11" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Navigation -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,-10,4,8">
                        <StackPanel x:Name="NavPanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ═══════ Inhalt ═══════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Titelleiste -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="{l:T Window.Minimize}" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="{l:T Window.Maximize}" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="{l:T Window.Close}" />
                </StackPanel>

                <!-- Seitenkopf -->
                <Grid Grid.Row="1" Margin="36,0,40,22">
                    <StackPanel>
                        <TextBlock x:Name="PageEyebrow" Text="MODUL" Style="{StaticResource Label}" Foreground="{StaticResource Cyan}" />
                        <TextBlock x:Name="PageTitle" Text="" Style="{StaticResource H1}" Margin="0,2,0,0" />
                        <TextBlock x:Name="PageSubtitle" Text="" Style="{StaticResource Body}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource Chip}" Background="{StaticResource GlassPanel}" BorderBrush="{StaticResource GlassEdge}" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="12" />
                            <TextBlock x:Name="ClockText" Text="" FontFamily="{StaticResource DisplayFont}" FontSize="12" Margin="7,0,0,0" Foreground="{StaticResource Text}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <ContentControl x:Name="PageHost" Grid.Row="2" Focusable="False" Margin="-4,0,0,0" />
            </Grid>
        </Grid>
    </Grid>
</Window>
