<UserControl x:Class="EZTool.Modules.Hotkeys.HotkeysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:EZTool.Core"
             x:Name="Root">
    <UserControl.Resources>
        <!-- Tastenkappe -->
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="1,1,1,3" />
            <Setter Property="BorderBrush" Value="#40FFC20E" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2AFFFFFF" Offset="0" />
                        <GradientStop Color="#0CFFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Auswahl-Chip für Aktionen -->
        <DataTemplate x:Key="ActionChip">
            <RadioButton GroupName="hkaction" IsChecked="{Binding IsSelected, Mode=OneWay}" Margin="0,0,8,8" Cursor="Hand" FocusVisualStyle="{x:Null}"
                         Command="{Binding DataContext.SelectActionCommand, ElementName=Root}" CommandParameter="{Binding Id}">
                <RadioButton.Template>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="4" Padding="10,7,12,7" BorderThickness="1" Background="#0AFFFFFF" BorderBrush="{StaticResource StrokeSoft}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ic" Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                                <TextBlock x:Name="tx" Text="{Binding Label}" FontSize="12.5" Foreground="{StaticResource TextDim}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#99FFC20E" />
                                <Setter TargetName="tx" Property="Foreground" Value="{StaticResource Text}" />
                                <Setter TargetName="ic" Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </RadioButton.Template>
            </RadioButton>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,0,32,28">
        <StackPanel>
            <!-- ═══ Schnellstart ═══ -->
            <Border Style="{StaticResource Card}" Padding="22,16" Margin="0,0,0,16">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="46" Height="46" CornerRadius="4" Background="{StaticResource BlueSoft}" BorderBrush="#444DA8E8" BorderThickness="1">
                            <TextBlock Text="&#xE8D6;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource Blue}" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{l:T Hotkeys.QuickTitle}" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Body}" FontSize="12.5">
                                <Run Text="{l:T Hotkeys.Key.PageUp}" Foreground="{StaticResource Accent}" /><Run Text="{l:T Hotkeys.QuickNext}" /><Run Text="{l:T Hotkeys.Key.PageDown}" Foreground="{StaticResource Accent}" /><Run Text="{l:T Hotkeys.QuickPrev}" /><Run Text="{l:T Hotkeys.Key.Pause}" Foreground="{StaticResource Accent}" /><Run Text="{l:T Hotkeys.QuickPlayPause}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryButton}" Content="{l:T Hotkeys.QuickApply}" Command="{Binding ApplyMediaPresetCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ═══ Neue Belegung ═══ -->
                <Border Style="{StaticResource Card}" Padding="22" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{l:T Hotkeys.NewBinding}" Style="{StaticResource H2}" />

                        <TextBlock Text="{l:T Hotkeys.StepKey}" Style="{StaticResource Label}" Margin="0,18,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource KeyCap}" MinWidth="120">
                                <TextBlock Text="{Binding KeyText}" FontFamily="{StaticResource DisplayFont}" FontSize="15" Foreground="{StaticResource Text}" />
                            </Border>
                            <Button Style="{StaticResource GhostButton}" Content="{l:T Hotkeys.RecordKey}" Command="{Binding RecordKeyCommand}" Margin="12,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Conflict}" Foreground="{StaticResource Amber}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Conflict, Converter={StaticResource Vis}}" />
                        <TextBlock Style="{StaticResource Body}" FontSize="11.5" Margin="0,8,0,0" Text="{l:T Hotkeys.ModifierTip}" />

                        <TextBlock Text="{l:T Hotkeys.StepActionMedia}" Style="{StaticResource Label}" Margin="0,20,0,8" />
                        <ItemsControl ItemsSource="{Binding MediaActions}" ItemTemplate="{StaticResource ActionChip}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="{l:T Hotkeys.Other}" Style="{StaticResource Label}" Margin="0,8,0,8" />
                        <ItemsControl ItemsSource="{Binding OtherActions}" ItemTemplate="{StaticResource ActionChip}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Zusatz: Ziel-Taste -->
                        <StackPanel Visibility="{Binding ShowTarget, Converter={StaticResource Vis}}" Margin="0,8,0,0">
                            <TextBlock Text="{l:T Hotkeys.SendInstead}" Style="{StaticResource Label}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource KeyCap}" MinWidth="120" BorderBrush="#444DA8E8">
                                    <TextBlock Text="{Binding TargetText}" FontFamily="{StaticResource DisplayFont}" FontSize="15" Foreground="{StaticResource Text}" />
                                </Border>
                                <Button Style="{StaticResource GhostButton}" Content="{l:T Hotkeys.RecordTargetKey}" Command="{Binding RecordTargetCommand}" Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Zusatz: Programm -->
                        <Grid Visibility="{Binding ShowProgram, Converter={StaticResource Vis}}" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding ProgramPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{l:T Hotkeys.Browse}" Command="{Binding BrowseProgramCommand}" Margin="8,0,0,0" />
                        </Grid>

                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddBindingCommand}" HorizontalAlignment="Left" Margin="0,20,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                <TextBlock Text="{l:T Hotkeys.SaveBinding}" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ═══ Aktive Belegungen ═══ -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{l:T Hotkeys.YourBindings}" Style="{StaticResource H2}" />
                        <TextBlock Text="{l:T Hotkeys.NoBindings}" Style="{StaticResource Body}" Margin="0,10,0,0"
                                   Visibility="{Binding Bindings.Count, Converter={StaticResource InvVis}}" />
                        <ItemsControl ItemsSource="{Binding Bindings}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="row" CornerRadius="4" Padding="12,10" Margin="0,4" Background="#08FFFFFF" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource KeyCap}" Padding="10,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding KeyText}" FontFamily="{StaticResource DisplayFont}" FontSize="13.5" Foreground="{StaticResource Text}" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource TextMute}"
                                                       VerticalAlignment="Center" Margin="12,0" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ActionIcon}" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ActionText}" Foreground="{StaticResource Text}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="{l:T Hotkeys.TestTip}" Width="30" Height="30"
                                                        Command="{Binding DataContext.TestCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Enabled}" Margin="8,0,8,0" VerticalAlignment="Center" ToolTip="{l:T Hotkeys.EnabledTip}" />
                                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="{l:T Hotkeys.RemoveTip}" Width="30" Height="30" Foreground="{StaticResource Red}"
                                                        Command="{Binding DataContext.RemoveCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                            <Setter TargetName="row" Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Rectangle Height="1" Fill="{StaticResource StrokeSoft}" Margin="0,16,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="13" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock Style="{StaticResource Body}" FontSize="11.5" Margin="10,0,0,0" MaxWidth="460" Text="{l:T Hotkeys.Footer}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
