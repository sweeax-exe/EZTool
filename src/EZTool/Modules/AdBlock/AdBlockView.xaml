<UserControl x:Class="EZTool.Modules.AdBlock.AdBlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EZTool.Controls"
             xmlns:l="clr-namespace:EZTool.Core">
    <UserControl.Resources>
        <!-- Große Ziffern wie im Dashboard -->
        <Style x:Key="Readout" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="64" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontStretch" Value="Condensed" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="62" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style x:Key="KeyBar" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <!-- Status einer Anfrage: kleines Farbfeld + Text -->
        <Style x:Key="StatusMark" TargetType="Rectangle">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Fill" Value="{StaticResource TextMute}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="Blocked">
                    <Setter Property="Fill" Value="{StaticResource Red}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Allowed">
                    <Setter Property="Fill" Value="{StaticResource Green}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Local">
                    <Setter Property="Fill" Value="{StaticResource Blue}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Failed">
                    <Setter Property="Fill" Value="{StaticResource Amber}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SmallGhost" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,0,32,32">
        <StackPanel>

            <!-- Hinweise -->
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16" BorderBrush="#55FF9F1C"
                    Visibility="{Binding IsAdmin, Converter={StaticResource InvVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Amber}" />
                    <TextBlock Text="{l:T AdBlock.NeedsAdmin}" Style="{StaticResource Body}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16" BorderBrush="#88F0443A">
                <Border.Visibility>
                    <Binding Path="Error" Converter="{StaticResource Vis}" />
                </Border.Visibility>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE783;" Style="{StaticResource Icon}" Foreground="{StaticResource Red}" />
                    <TextBlock Text="{Binding Error}" Style="{StaticResource Body}" Foreground="{StaticResource Text}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ═══ Messfeld ═══ -->
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <!-- Status + Schalter -->
                    <StackPanel Margin="22,18,22,20">
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource KeyBar}">
                                    <Setter Property="Background" Value="{StaticResource TextMute}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="{l:T AdBlock.Status}" Style="{StaticResource H2}" FontSize="15" />
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Readout}">
                                    <Setter Property="Text" Value="{l:T AdBlock.StatusOff}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextMute}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Text" Value="{l:T AdBlock.StatusOn}" />
                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Text" Value="…" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Grid Margin="0,14,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="{l:T AdBlock.Enable}" Command="{Binding ToggleCommand}" HorizontalAlignment="Left"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                                    Visibility="{Binding IsRunning, Converter={StaticResource InvVis}}" />
                            <Button Style="{StaticResource GhostButton}" Content="{l:T AdBlock.Disable}" Command="{Binding ToggleCommand}" HorizontalAlignment="Left"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                                    Visibility="{Binding IsRunning, Converter={StaticResource Vis}}" />
                        </Grid>
                        <ProgressBar Style="{StaticResource NeonBar}" IsIndeterminate="True" Height="6" Margin="0,12,0,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource Vis}}" />
                    </StackPanel>

                    <!-- Heute blockiert -->
                    <Border Grid.Column="1" BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0" Padding="22,18,22,20">
                        <StackPanel>
                            <Border Style="{StaticResource KeyBar}" Background="{StaticResource Red}" />
                            <TextBlock Text="{l:T AdBlock.BlockedToday}" Style="{StaticResource H2}" FontSize="15" />
                            <TextBlock Text="{Binding BlockedText}" Style="{StaticResource Readout}" />
                            <c:SegmentMeter Height="14" Margin="0,14,0,0" Segments="24" Value="{Binding BlockRate}" Brush="{StaticResource Red}" />
                            <TextBlock Text="{Binding BlockRateText}" Style="{StaticResource Label}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Anfragen heute -->
                    <Border Grid.Column="2" BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0" Padding="22,18,22,20">
                        <StackPanel>
                            <Border Style="{StaticResource KeyBar}" Background="{StaticResource Green}" />
                            <TextBlock Text="{l:T AdBlock.QueriesToday}" Style="{StaticResource H2}" FontSize="15" />
                            <TextBlock Text="{Binding QueriesText}" Style="{StaticResource Readout}" />
                        </StackPanel>
                    </Border>

                    <!-- Domains auf den Listen -->
                    <Border Grid.Column="3" BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0" Padding="22,18,22,20">
                        <StackPanel>
                            <Border Style="{StaticResource KeyBar}" Background="{StaticResource TextDim}" />
                            <TextBlock Text="{l:T AdBlock.Domains}" Style="{StaticResource H2}" FontSize="15" />
                            <TextBlock Text="{Binding DomainsText}" Style="{StaticResource Readout}" />
                            <TextBlock Text="{Binding ListsUpdatedText}" Style="{StaticResource Label}" Margin="0,14,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ Protokoll + Seitenleiste ═══ -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.9*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- Live-Protokoll -->
                <Border Style="{StaticResource Card}" Padding="20,18,12,12" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,8,12">
                            <TextBlock Text="{l:T AdBlock.Log}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Style="{StaticResource Chip}" Padding="2" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T AdBlock.LogAll}" GroupName="logf" Padding="10,4"
                                                     IsChecked="{Binding OnlyBlocked, Converter={StaticResource Not}, Mode=OneWay}"
                                                     Command="{Binding SetOnlyBlockedCommand}" CommandParameter="False" />
                                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T AdBlock.LogBlocked}" GroupName="logf" Padding="10,4"
                                                     IsChecked="{Binding OnlyBlocked, Mode=OneWay}"
                                                     Command="{Binding SetOnlyBlockedCommand}" CommandParameter="True" />
                                    </StackPanel>
                                </Border>
                                <TextBox Style="{StaticResource SearchBox}" Width="220" Tag="{l:T AdBlock.LogSearch}"
                                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{l:T AdBlock.LogEmpty}" Style="{StaticResource Body}" Margin="0,24,0,32" HorizontalAlignment="Center"
                                   Visibility="{Binding HasLog, Converter={StaticResource InvVis}}" />
                        <ListBox Grid.Row="1" Style="{StaticResource CleanList}" ItemsSource="{Binding Log}" Height="560"
                                 Visibility="{Binding HasLog, Converter={StaticResource Vis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="34" Margin="8,0,4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource Value}" FontSize="12.5" Foreground="{StaticResource TextMute}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Rectangle Style="{StaticResource StatusMark}" />
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource Label}" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Domain}" Foreground="{StaticResource Text}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Domain}" />
                                            <TextBlock Text="{Binding Via}" Style="{StaticResource Label}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Entry.Via, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding Type}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding Ms}" Style="{StaticResource Label}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" />
                                        <Grid Grid.Column="5" Width="96" Visibility="{Binding CanAct, Converter={StaticResource Vis}}">
                                            <Button Style="{StaticResource SmallGhost}" Content="{l:T AdBlock.Allow}" HorizontalAlignment="Right"
                                                    Command="{Binding DataContext.AllowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding IsBlocked, Converter={StaticResource Vis}}" />
                                            <Button Style="{StaticResource SmallGhost}" Content="{l:T AdBlock.Block}" HorizontalAlignment="Right"
                                                    Command="{Binding DataContext.BlockCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding IsBlocked, Converter={StaticResource InvVis}}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2">
                    <!-- Am häufigsten blockiert -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:T AdBlock.TopBlocked}" Style="{StaticResource H2}" />
                            <TextBlock Text="{l:T AdBlock.TopEmpty}" Style="{StaticResource Body}" Margin="0,10,0,0"
                                       Visibility="{Binding HasTop, Converter={StaticResource InvVis}}" />
                            <ItemsControl ItemsSource="{Binding Top}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,8,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Domain}" Foreground="{StaticResource Text}" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Domain}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Count}" Style="{StaticResource Value}" FontSize="13" Margin="10,0,0,0" />
                                            </Grid>
                                            <ProgressBar Style="{StaticResource NeonBar}" Height="6" Margin="0,5,0,0" Value="{Binding Percent, Mode=OneWay}" Foreground="{StaticResource Red}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Blocklisten -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T AdBlock.Lists}" Style="{StaticResource H2}" />
                            <ItemsControl ItemsSource="{Binding Lists}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsOn}" Margin="0,10,0,0" VerticalContentAlignment="Top">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="13" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" FontSize="12" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,16,0,0">
                                <Button Style="{StaticResource SmallGhost}" HorizontalAlignment="Left" Command="{Binding UpdateListsCommand}"
                                        IsEnabled="{Binding IsUpdatingLists, Converter={StaticResource Not}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                        <TextBlock Text="{l:T AdBlock.UpdateLists}" Margin="7,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{l:T AdBlock.Updating}" Style="{StaticResource Label}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Visibility="{Binding IsUpdatingLists, Converter={StaticResource Vis}}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- DNS-Anbieter -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T AdBlock.Upstream}" Style="{StaticResource H2}" />
                            <Border Style="{StaticResource Chip}" Padding="2" Margin="0,12,0,0" HorizontalAlignment="Left">
                                <ItemsControl ItemsSource="{Binding Upstreams}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Style="{StaticResource SegmentButton}" Content="{Binding Name}" GroupName="ups" Padding="12,5"
                                                         Command="{Binding DataContext.SetUpstreamCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                         CommandParameter="{Binding Id}">
                                                <RadioButton.IsChecked>
                                                    <MultiBinding Mode="OneWay">
                                                        <MultiBinding.Converter>
                                                            <l:EqualsMultiConverter />
                                                        </MultiBinding.Converter>
                                                        <Binding Path="Id" />
                                                        <Binding Path="DataContext.Upstream" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    </MultiBinding>
                                                </RadioButton.IsChecked>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Text="{l:T AdBlock.UpstreamNote}" Style="{StaticResource Body}" FontSize="12" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Eigene Regeln -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T AdBlock.Rules}" Style="{StaticResource H2}" />
                            <TextBox Style="{StaticResource FieldBox}" Margin="0,12,0,0" Text="{Binding RuleInput, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{l:T AdBlock.RulePlaceholder}" />
                            <TextBlock Text="{l:T AdBlock.RulePlaceholder}" Style="{StaticResource Label}" FontSize="11" Margin="0,5,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource SmallGhost}" Content="{l:T AdBlock.RuleAllow}" Command="{Binding AddAllowCommand}" />
                                <Button Style="{StaticResource SmallGhost}" Content="{l:T AdBlock.RuleBlock}" Command="{Binding AddBlockCommand}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding RuleError}" Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource Red}" Margin="0,8,0,0"
                                       Visibility="{Binding RuleError, Converter={StaticResource Vis}}" />
                            <TextBlock Text="{l:T AdBlock.RulesEmpty}" Style="{StaticResource Body}" FontSize="12" Margin="0,14,0,0"
                                       Visibility="{Binding HasRules, Converter={StaticResource InvVis}}" />
                            <ItemsControl ItemsSource="{Binding Rules}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Domain}" Foreground="{StaticResource Text}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Kind}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="10,0,4,0" />
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" Width="28" Height="28" FontSize="11"
                                                    Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Gut zu wissen -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{l:T AdBlock.Limits}" Style="{StaticResource H2}" />
                    <TextBlock Text="{l:T AdBlock.LimitsText}" Style="{StaticResource Body}" Margin="0,8,0,0" MaxWidth="900" HorizontalAlignment="Left" />
                    <TextBlock Text="{l:T AdBlock.Rescue}" Style="{StaticResource Body}" Margin="0,8,0,0" MaxWidth="900" HorizontalAlignment="Left" />
                    <Button Style="{StaticResource SmallGhost}" Content="{l:T AdBlock.RescueButton}" Command="{Binding RescueCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"
                            Visibility="{Binding CanRescue, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
