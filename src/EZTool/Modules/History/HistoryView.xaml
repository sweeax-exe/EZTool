<UserControl x:Class="EZTool.Modules.History.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EZTool.Controls"
             xmlns:l="clr-namespace:EZTool.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,0,32,28">
        <StackPanel>
            <!-- Werkzeugleiste -->
            <Grid Margin="0,0,0,14">
                <Border Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="4" Padding="3" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T History.Range15m}" GroupName="hr" Command="{Binding SetRangeCommand}" CommandParameter="15" IsChecked="{Binding RangeMinutes, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=15}" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T History.Range1h}" GroupName="hr" Command="{Binding SetRangeCommand}" CommandParameter="60" IsChecked="{Binding RangeMinutes, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=60}" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T History.Range6h}" GroupName="hr" Command="{Binding SetRangeCommand}" CommandParameter="360" IsChecked="{Binding RangeMinutes, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=360}" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T History.Range24h}" GroupName="hr" Command="{Binding SetRangeCommand}" CommandParameter="1440" IsChecked="{Binding RangeMinutes, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=1440}" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Run Text="{Binding SampleCount, Mode=OneWay, StringFormat={}{0:N0}}" /><Run Text="{l:T History.Samples}" />
                    </TextBlock>
                    <Button Style="{StaticResource GhostButton}" Content="{l:T History.ExportCsv}" Command="{Binding ExportCommand}" Padding="14,8" Margin="0,0,8,0" />
                    <Button Style="{StaticResource GhostButton}" Content="{l:T History.LogFolder}" Command="{Binding OpenFolderCommand}" Padding="14,8" />
                </StackPanel>
            </Grid>

            <!-- Kennzahlen -->
            <UniformGrid Columns="4" Margin="-8,0,-8,16">
                <Border Style="{StaticResource Card}" Margin="8,0" Padding="20,14">
                    <StackPanel>
                        <TextBlock Text="{l:T History.CpuMax}" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding CpuTempMax}" Style="{StaticResource BigValue}" FontSize="28" Foreground="{StaticResource Accent}" />
                        <TextBlock Text="{Binding CpuTempMaxAt}" Style="{StaticResource Body}" FontSize="11.5" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0" Padding="20,14">
                    <StackPanel>
                        <TextBlock Text="{l:T History.GpuMax}" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding GpuTempMax}" Style="{StaticResource BigValue}" FontSize="28" Foreground="{StaticResource Blue}" />
                        <TextBlock Text="{Binding GpuTempMaxAt}" Style="{StaticResource Body}" FontSize="11.5" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0" Padding="20,14">
                    <StackPanel>
                        <TextBlock Text="{l:T History.CpuAvg}" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding CpuLoadAvg}" Style="{StaticResource BigValue}" FontSize="28" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0" Padding="20,14">
                    <StackPanel>
                        <TextBlock Text="{l:T History.GpuAvg}" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding GpuLoadAvg}" Style="{StaticResource BigValue}" FontSize="28" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Temperaturen -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9CA;" Style="{StaticResource Icon}" FontSize="14" />
                            <TextBlock Text="{l:T History.Temperatures}" Style="{StaticResource H2}" FontSize="15" Margin="10,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Rectangle Width="14" Height="4" Fill="{StaticResource Accent}" VerticalAlignment="Center" />
                            <TextBlock Text="CPU" Style="{StaticResource Label}" Margin="6,0,14,0" VerticalAlignment="Center" />
                            <Rectangle Width="14" Height="4" Fill="{StaticResource Blue}" VerticalAlignment="Center" />
                            <TextBlock Text="GPU" Style="{StaticResource Label}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <c:TimeChart Series="{Binding TempSeries}" Times="{Binding Times}" Maximum="0" Height="240" Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <!-- Auslastung -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" Style="{StaticResource Icon}" FontSize="14" />
                            <TextBlock Text="{l:T History.Load}" Style="{StaticResource H2}" FontSize="15" Margin="10,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Rectangle Width="14" Height="4" Fill="{StaticResource Accent}" VerticalAlignment="Center" />
                            <TextBlock Text="CPU" Style="{StaticResource Label}" Margin="6,0,14,0" VerticalAlignment="Center" />
                            <Rectangle Width="14" Height="4" Fill="{StaticResource Blue}" VerticalAlignment="Center" />
                            <TextBlock Text="GPU" Style="{StaticResource Label}" Margin="6,0,14,0" VerticalAlignment="Center" />
                            <Rectangle Width="14" Height="4" Fill="{StaticResource Green}" VerticalAlignment="Center" />
                            <TextBlock Text="RAM" Style="{StaticResource Label}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <c:TimeChart Series="{Binding LoadSeries}" Times="{Binding Times}" Maximum="100" Height="220" Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <!-- FPS (nur wenn der Gaming-Modus gemessen hat) -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HasFps, Converter={StaticResource Vis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Amber}" />
                        <TextBlock Text="{l:T History.Fps}" Style="{StaticResource H2}" FontSize="15" Margin="10,0,0,0" />
                    </StackPanel>
                    <c:TimeChart Series="{Binding FpsSeries}" Times="{Binding Times}" Maximum="0" Height="200" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
