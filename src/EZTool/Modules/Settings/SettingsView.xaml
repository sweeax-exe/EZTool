<UserControl x:Class="EZTool.Modules.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:EZTool.Core"
             x:Name="Root">
    <UserControl.Resources>
        <!-- Kopfzeile einer Einstellungs-Karte -->
        <Style x:Key="SectionIcon" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{StaticResource CyanSoft}" />
            <Setter Property="BorderBrush" Value="#3300E5FF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,0,32,32">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══════════ Linke Spalte ═══════════ -->
            <StackPanel>
                <!-- Sprache -->
                <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource SectionIcon}">
                                <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{l:T Language.Title}" Style="{StaticResource H2}" />
                                <TextBlock Text="{l:T Language.Subtitle}" Style="{StaticResource Body}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>

                        <Border Margin="0,20,0,0" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="10" Padding="3">
                            <ItemsControl ItemsSource="{Binding Languages}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource SegmentButton}" Content="{Binding Label}" ToolTip="{Binding ToolTip}" GroupName="lang"
                                                     IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                     Command="{Binding DataContext.SelectLanguageCommand, ElementName=Root}" CommandParameter="{Binding Code}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Start & Hintergrund -->
                <Border Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource SectionIcon}">
                                <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{l:T Settings.StartTitle}" Style="{StaticResource H2}" />
                                <TextBlock Text="{l:T Settings.StartSubtitle}" Style="{StaticResource Body}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Style="{StaticResource Row}" Margin="0,22,0,0">
                            <StackPanel Margin="0,0,70,0">
                                <TextBlock Text="{l:T Settings.StartWithWindows}" Foreground="{StaticResource Text}" FontSize="13.5" />
                                <TextBlock Text="{l:T Settings.StartWithWindowsHint}" Style="{StaticResource Body}" FontSize="12" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding StartWithWindows}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <StackPanel Margin="0,0,70,0">
                                <TextBlock Text="{l:T Settings.CloseToTray}" Foreground="{StaticResource Text}" FontSize="13.5" />
                                <TextBlock Text="{l:T Settings.CloseToTrayHint}" Style="{StaticResource Body}" FontSize="12" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding CloseToTray}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <StackPanel>
                                <TextBlock Text="{l:T Settings.Interval}" Foreground="{StaticResource Text}" FontSize="13.5" />
                                <TextBlock Text="{l:T Settings.IntervalHint}" Style="{StaticResource Body}" FontSize="12" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="10" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Settings.Interval05}" GroupName="iv" Command="{Binding SetIntervalCommand}" CommandParameter="0"
                                                 IsChecked="{Binding IntervalIndex, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=0}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="1 s" GroupName="iv" Command="{Binding SetIntervalCommand}" CommandParameter="1"
                                                 IsChecked="{Binding IntervalIndex, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=1}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="2 s" GroupName="iv" Command="{Binding SetIntervalCommand}" CommandParameter="2"
                                                 IsChecked="{Binding IntervalIndex, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=2}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sensor-Treiber -->
                <Border Style="{StaticResource Card}" Padding="22" Margin="0,18,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource SectionIcon}">
                                <TextBlock Text="&#xE9CA;" Style="{StaticResource Icon}" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{l:T Settings.DriverTitle}" Style="{StaticResource H2}" />
                                <TextBlock Text="{l:T Settings.DriverSubtitle}" Style="{StaticResource Body}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>

                        <Border Margin="0,20,0,0" CornerRadius="12" Padding="14,12" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#14FFB547" />
                                    <Setter Property="BorderBrush" Value="#44FFB547" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DriverOk}" Value="True">
                                            <Setter Property="Background" Value="#142CF5A0" />
                                            <Setter Property="BorderBrush" Value="#442CF5A0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE7BA;" />
                                            <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DriverOk}" Value="True">
                                                    <Setter Property="Text" Value="&#xE73E;" />
                                                    <Setter Property="Foreground" Value="{StaticResource Green}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding DriverStatus}" Foreground="{StaticResource Text}" FontSize="13" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="420" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,14,0,0" LineHeight="18" Text="{l:T Settings.DriverInfo}" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding InstallDriverCommand}" Padding="18,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DriverButtonText}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Content="{l:T Settings.ProjectPage}" Margin="10,0,0,0"
                                    Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/namazso/PawnIO.Setup" />
                        </StackPanel>
                        <TextBlock Text="{l:T Settings.DriverNeedsAdmin}" Style="{StaticResource Body}" FontSize="11.5" Foreground="{StaticResource Amber}"
                                   Margin="0,10,0,0" Visibility="{Binding IsAdmin, Converter={StaticResource InvVis}}" />
                    </StackPanel>
                </Border>

                <!-- Programm-Updates -->
                <Border Style="{StaticResource Card}" Padding="22" Margin="0,18,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource SectionIcon}" Background="#1A2CF5A0" BorderBrush="#442CF5A0">
                                <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Foreground="{StaticResource Green}" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{l:T Settings.UpdatesTitle}" Style="{StaticResource H2}" />
                                <TextBlock Text="{l:T Settings.UpdatesSubtitle}" Style="{StaticResource Body}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding UpdateStatus}" Foreground="{StaticResource Text}" FontSize="13" Margin="0,18,0,0" TextWrapping="Wrap" />
                        <Border Margin="0,10,0,0" CornerRadius="10" Padding="12,8" Background="#08FFFFFF" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1"
                                MaxHeight="140" Visibility="{Binding UpdateNotes, Converter={StaticResource Vis}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding UpdateNotes}" Style="{StaticResource Body}" FontSize="12" />
                            </ScrollViewer>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding InstallUpdateCommand}" Padding="16,9" Margin="0,0,10,0"
                                    Visibility="{Binding UpdateAvailable, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                    <TextBlock Text="{l:T Settings.UpdateNow}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Content="{l:T Settings.CheckUpdates}" Command="{Binding CheckUpdatesCommand}" Margin="0,0,10,0" />
                            <Button Style="{StaticResource GhostButton}" Content="GitHub" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding RepoUrl}" />
                        </StackPanel>

                        <Grid Style="{StaticResource Row}">
                            <TextBlock Text="{l:T Settings.AutoCheck}" Foreground="{StaticResource Text}" FontSize="13.5" VerticalAlignment="Center" />
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding AutoUpdateCheck}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Style="{StaticResource Row}" IsEnabled="{Binding AutoUpdateCheck}">
                            <StackPanel Margin="0,0,70,0">
                                <TextBlock Text="{l:T Settings.AutoInstall}" Foreground="{StaticResource Text}" FontSize="13.5" />
                                <TextBlock Text="{l:T Settings.AutoInstallHint}" Style="{StaticResource Body}" FontSize="12" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding AutoUpdateInstall}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Info -->
                <Border Style="{StaticResource Card}" Padding="22" Margin="0,18,0,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}">
                                <Run Text="EZTool" /><Run Text=" " /><Run Text="{Binding Version, Mode=OneWay}" Foreground="{StaticResource Cyan}" />
                            </TextBlock>
                            <TextBlock Text="{Binding SettingsPath}" Style="{StaticResource Body}" FontSize="11.5" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Content="{l:T Settings.Backups}" Command="{Binding OpenFolderCommand}" CommandParameter="backups" Padding="12,7" />
                            <Button Style="{StaticResource GhostButton}" Content="{l:T Settings.SettingsFolder}" Command="{Binding OpenFolderCommand}" CommandParameter="settings" Padding="12,7" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ═══════════ Rechte Spalte ═══════════ -->
            <StackPanel Grid.Column="2">
                <!-- Alarme -->
                <Border Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource SectionIcon}" Background="#1AFF4D6D" BorderBrush="#33FF4D6D">
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Red}" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{l:T Settings.AlertsTitle}" Style="{StaticResource H2}" />
                                    <TextBlock Text="{l:T Settings.AlertsSubtitle}" Style="{StaticResource Body}" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding AlertsEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel IsEnabled="{Binding AlertsEnabled}">
                            <Grid Margin="0,24,0,6">
                                <TextBlock Text="{l:T Settings.CpuLimit}" Style="{StaticResource Label}" />
                                <TextBlock Style="{StaticResource Value}" FontSize="13" Foreground="{StaticResource Cyan}" HorizontalAlignment="Right">
                                    <Run Text="{Binding CpuTempLimit, Mode=OneWay}" /><Run Text=" °C" />
                                </TextBlock>
                            </Grid>
                            <Slider Minimum="60" Maximum="100" TickFrequency="5" Value="{Binding CpuTempLimit}" />

                            <Grid Margin="0,18,0,6">
                                <TextBlock Text="{l:T Settings.GpuLimit}" Style="{StaticResource Label}" />
                                <TextBlock Style="{StaticResource Value}" FontSize="13" Foreground="{StaticResource Cyan}" HorizontalAlignment="Right">
                                    <Run Text="{Binding GpuTempLimit, Mode=OneWay}" /><Run Text=" °C" />
                                </TextBlock>
                            </Grid>
                            <Slider Minimum="60" Maximum="100" TickFrequency="5" Value="{Binding GpuTempLimit}" />

                            <Grid Margin="0,18,0,6">
                                <TextBlock Text="{l:T Settings.DriveLimit}" Style="{StaticResource Label}" />
                                <TextBlock Style="{StaticResource Value}" FontSize="13" Foreground="{StaticResource Cyan}" HorizontalAlignment="Right">
                                    <Run Text="{Binding DriveFreeLimit, Mode=OneWay}" /><Run Text=" %" />
                                </TextBlock>
                            </Grid>
                            <Slider Minimum="5" Maximum="30" TickFrequency="5" Value="{Binding DriveFreeLimit}" />

                            <Button Style="{StaticResource GhostButton}" Content="{l:T Settings.TestAlert}" Command="{Binding TestAlertCommand}"
                                    HorizontalAlignment="Left" Margin="0,20,0,0" Padding="14,8" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Overlay -->
                <Border Style="{StaticResource Card}" Padding="22" Margin="0,18,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource SectionIcon}" Background="{StaticResource VioletSoft}" BorderBrush="#448B5CF6">
                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" Foreground="{StaticResource Violet}" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{l:T Settings.OverlayTitle}" Style="{StaticResource H2}" />
                                    <TextBlock Text="{l:T Settings.OverlaySubtitle}" Style="{StaticResource Body}" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding OverlayEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel IsEnabled="{Binding OverlayEnabled}">
                            <TextBlock Text="{l:T Settings.Position}" Style="{StaticResource Label}" Margin="0,24,0,8" />
                            <Border Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Settings.TopLeft}" GroupName="oc" Command="{Binding SetCornerCommand}" CommandParameter="TopLeft"
                                                 IsChecked="{Binding OverlayCorner, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=TopLeft}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Settings.TopRight}" GroupName="oc" Command="{Binding SetCornerCommand}" CommandParameter="TopRight"
                                                 IsChecked="{Binding OverlayCorner, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=TopRight}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Settings.BottomLeft}" GroupName="oc" Command="{Binding SetCornerCommand}" CommandParameter="BottomLeft"
                                                 IsChecked="{Binding OverlayCorner, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=BottomLeft}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Settings.BottomRight}" GroupName="oc" Command="{Binding SetCornerCommand}" CommandParameter="BottomRight"
                                                 IsChecked="{Binding OverlayCorner, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=BottomRight}" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,20,0,6">
                                <TextBlock Text="{l:T Settings.Opacity}" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding OverlayOpacity, StringFormat={}{0:P0}}" Style="{StaticResource Value}" FontSize="13" Foreground="{StaticResource Cyan}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="0.3" Maximum="1" TickFrequency="0.05" Value="{Binding OverlayOpacity}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
