<UserControl x:Class="EZTool.Modules.Gaming.GamingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EZTool.Controls"
             xmlns:l="clr-namespace:EZTool.Core">
    <UserControl.Resources>
        <!-- Großer Boost-Taster: eine eckige Taste in einer eingelassenen Fassung, die beim Drücken nachgibt -->
        <Style x:Key="BoostButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Width="184" Height="184" CornerRadius="8" Background="{StaticResource Well}" Padding="8">
                            <Grid x:Name="keyGrid">
                                <Border x:Name="key" CornerRadius="5" Background="{TemplateBinding Background}"
                                        BorderBrush="#40000000" BorderThickness="0,0,0,5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="hi" CornerRadius="5" Background="#FFFFFF" Opacity="0" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hi" Property="Opacity" Value="0.12" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="keyGrid" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="3" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="key" Property="BorderThickness" Value="0,0,0,2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,0,32,28">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ═══ Boost ═══ -->
                <Border Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                        <Grid HorizontalAlignment="Center">
                            <Button Style="{StaticResource BoostButton}" Command="{Binding ToggleCommand}" Background="{StaticResource Accent}"
                                    Visibility="{Binding IsActive, Converter={StaticResource InvVis}}">
                                <StackPanel>
                                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="30" Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{l:T Gaming.Boost}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontStretch="Condensed" FontSize="30" Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BoostButton}" Command="{Binding ToggleCommand}" Background="{StaticResource Red}"
                                    Visibility="{Binding IsActive, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="28" Foreground="White" HorizontalAlignment="Center" />
                                    <TextBlock Text="{l:T Gaming.Stop}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontStretch="Condensed" FontSize="26" Foreground="White" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock HorizontalAlignment="Center" Margin="0,16,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource H2}">
                                    <Setter Property="Text" Value="{l:T Gaming.StateOff}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Text" Value="{l:T Gaming.StateOn}" />
                                            <Setter Property="Foreground" Value="{StaticResource Blue}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding SinceText}" Style="{StaticResource Body}" HorizontalAlignment="Center" FontSize="12" />

                        <ItemsControl ItemsSource="{Binding Actions}" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Green}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="12.5" Foreground="{StaticResource Text}" Margin="10,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{l:T Gaming.RestoreHint}" Style="{StaticResource Body}" FontSize="11.5" Margin="0,12,0,0" Visibility="{Binding IsActive, Converter={StaticResource InvVis}}" TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- ═══ Live-FPS ═══ -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" Foreground="{StaticResource Amber}" />
                                <TextBlock Text="{l:T Gaming.Live}" Style="{StaticResource Label}" Foreground="{StaticResource Amber}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding GameName}" Style="{StaticResource Body}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="400" TextWrapping="NoWrap" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding FpsText}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontStretch="Condensed" FontSize="96" Foreground="{StaticResource Text}" />
                                <StackPanel VerticalAlignment="Bottom" Margin="10,0,0,20">
                                    <TextBlock Text="FPS" Style="{StaticResource H2}" Foreground="{StaticResource Amber}" />
                                    <TextBlock Text="{Binding FrameTimeText}" Style="{StaticResource Body}" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="CPU" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding CpuTemp}" Style="{StaticResource Value}" FontSize="20" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" />
                                <TextBlock Text="GPU" Style="{StaticResource Label}" HorizontalAlignment="Right" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding GpuTemp}" Style="{StaticResource Value}" FontSize="20" Foreground="{StaticResource Blue}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                        <c:Sparkline Grid.Row="2" Values="{Binding FpsHistory}" Stroke="#FF9F1C" Maximum="0" MinHeight="90" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="3" Text="{Binding MeasureHint}" Style="{StaticResource Body}" FontSize="11.5" Margin="0,10,0,0" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ Optionen ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{l:T Gaming.OnBoost}" Style="{StaticResource Label}" Margin="0,0,0,10" />
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding BoostPowerPlan}" Content="{l:T Gaming.Option.PowerPlan}" Margin="0,4" />
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding BoostPurgeRam}" Content="{l:T Gaming.Option.PurgeRam}" Margin="0,4" />
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding BoostPauseUpdates}" Content="{l:T Gaming.Option.PauseUpdates}" Margin="0,4" />
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding BoostRestartApps}" Content="{l:T Gaming.Option.RestartApps}" Margin="0,4" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{l:T Gaming.CloseAppsLabel}" Style="{StaticResource Label}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Apps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton IsChecked="{Binding IsSelected}" Margin="0,0,8,8" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="{Binding Name}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="bd" CornerRadius="4" Padding="8,5,10,5" BorderThickness="1" Background="#0AFFFFFF" BorderBrush="{StaticResource StrokeSoft}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,7,0" />
                                                        <TextBlock x:Name="tx" Text="{Binding Display}" FontSize="12" Foreground="{StaticResource TextDim}" MaxWidth="170" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="#55FFFFFF" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#224DA8E8" />
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="#994DA8E8" />
                                                        <Setter TargetName="tx" Property="Foreground" Value="{StaticResource Text}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{l:T Gaming.CloseAppsHint}" Style="{StaticResource Body}" FontSize="11.5" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Sessions ═══ -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{l:T Gaming.RecentSessions}" Style="{StaticResource Label}" Margin="6,0,0,8" />
                        <TextBlock Text="{l:T Gaming.NoSessions}" Style="{StaticResource Body}" FontSize="12" Margin="6,4"
                                   Visibility="{Binding Sessions.Count, Converter={StaticResource InvVis}}" />
                        <ListBox Style="{StaticResource CleanList}" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" MaxHeight="420">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Game}" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,70,0" />
                                            <TextBlock Style="{StaticResource Body}" FontSize="11.5">
                                                <Run Text="{Binding Start, Mode=OneWay, StringFormat={l:T Gaming.SessionDate}}" /><Run Text=" · " /><Run Text="{Binding DurationText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource DisplayFont}" FontSize="15" Foreground="{StaticResource Amber}">
                                                <Run Text="{Binding FpsText, Mode=OneWay}" /><Run Text=" FPS" FontSize="11" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding SelectedSession, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <TextBlock Text="{l:T Gaming.SessionReport}" Style="{StaticResource Label}" Foreground="{StaticResource Amber}" />
                        <TextBlock Text="{Binding SelectedSession.Game}" Style="{StaticResource H2}" FontSize="20" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Body}" FontSize="12">
                            <Run Text="{Binding SelectedSession.Start, Mode=OneWay, StringFormat={l:T Gaming.SessionDateLong}}" /><Run Text=" · " /><Run Text="{Binding SelectedSession.DurationText, Mode=OneWay}" />
                        </TextBlock>

                        <UniformGrid Columns="4" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{l:T Gaming.AvgFps}" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding SelectedSession.FpsText}" Style="{StaticResource BigValue}" FontSize="30" Foreground="{StaticResource Amber}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{l:T Gaming.Low1}" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding SelectedSession.LowText}" Style="{StaticResource BigValue}" FontSize="30" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{l:T Gaming.MaxTemp}" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding SelectedSession.TempText}" Style="{StaticResource BigValue}" FontSize="24" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{l:T Gaming.Frames}" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding SelectedSession.Frames, StringFormat={}{0:N0}}" Style="{StaticResource BigValue}" FontSize="24" Margin="0,4,0,0" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="{l:T Gaming.FpsHistory}" Style="{StaticResource Label}" Margin="0,18,0,0" />
                        <c:TimeChart Series="{Binding ReportFps}" Times="{Binding ReportTimes}" Maximum="0" Height="150" Margin="0,8,0,0" />
                        <TextBlock Text="{l:T Gaming.Temperatures}" Style="{StaticResource Label}" Margin="0,12,0,0" />
                        <c:TimeChart Series="{Binding ReportTemps}" Times="{Binding ReportTimes}" Maximum="0" Height="150" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
