<UserControl x:Class="EZTool.Modules.Processes.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EZTool.Controls"
             xmlns:l="clr-namespace:EZTool.Core"
             x:Name="Root">
    <Grid Margin="40,0,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ Kopf: CPU-Verlauf + Kennzahlen ═══ -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="20,14">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{l:T Processes.CpuTotal}" Style="{StaticResource Label}" />
                        <TextBlock Style="{StaticResource BigValue}" FontSize="28" Foreground="{StaticResource Cyan}">
                            <Run Text="{Binding TotalCpu, Mode=OneWay, StringFormat={}{0:0}}" /><Run Text=" %" FontSize="16" Foreground="{StaticResource TextDim}" />
                        </TextBlock>
                    </StackPanel>
                    <c:Sparkline Values="{Binding CpuHistory}" Stroke="#00E5FF" Maximum="100" ShowGrid="False" Margin="140,4,0,4" Height="56" />
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,14">
                <StackPanel>
                    <TextBlock Text="{l:T Processes.MemoryLabel}" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding RamText}" Style="{StaticResource Value}" FontSize="18" Margin="0,6,0,8" />
                    <ProgressBar Style="{StaticResource NeonBar}" Value="{Binding RamLoad, Mode=OneWay}" Foreground="{StaticResource GreenGradient}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20,14">
                <StackPanel>
                    <TextBlock Text="{l:T Processes.CountLabel}" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding ProcessCount}" Style="{StaticResource BigValue}" FontSize="28" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ Werkzeugleiste ═══ -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBox Style="{StaticResource SearchBox}" Width="300" Tag="{l:T Processes.SearchHint}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                <Border Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="10" Padding="3" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" Content="CPU" IsChecked="True" GroupName="psrt" Command="{Binding SetSortCommand}" CommandParameter="cpu" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Processes.SortMemory}" GroupName="psrt" Command="{Binding SetSortCommand}" CommandParameter="ram" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Processes.SortName}" GroupName="psrt" Command="{Binding SetSortCommand}" CommandParameter="name" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock Text="{l:T Processes.RefreshInfo}" Style="{StaticResource Body}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- Tabellenkopf -->
        <Grid Grid.Row="2" Margin="0,0,22,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="84" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="{l:T Processes.ColProgram}" Style="{StaticResource Label}" />
            <TextBlock Grid.Column="2" Text="CPU" Style="{StaticResource Label}" />
            <TextBlock Grid.Column="3" Text="{l:T Processes.ColMemory}" Style="{StaticResource Label}" HorizontalAlignment="Right" />
        </Grid>

        <!-- ═══ Liste ═══ -->
        <ListBox Grid.Row="3" Style="{StaticResource CleanList}" ItemsSource="{Binding GroupsView}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="54" Margin="0,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="84" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="34" Height="34" HorizontalAlignment="Center">
                            <Border CornerRadius="10" Background="{Binding ProcessName, Converter={StaticResource NameBrush}}" Opacity="0.85">
                                <TextBlock Text="{Binding ProcessName, Converter={StaticResource Initial}}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                           FontSize="15" Foreground="#04060C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border CornerRadius="10" Background="#FF101828" Visibility="{Binding Icon, Converter={StaticResource Vis}}">
                                <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Text}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                <Border Style="{StaticResource Chip}" Padding="6,0" Margin="8,0,0,0" Visibility="{Binding HasMany, Converter={StaticResource Vis}}">
                                    <TextBlock FontSize="10.5" Foreground="{StaticResource Cyan}"><Run Text="{Binding Count, Mode=OneWay}" /><Run Text="×" /></TextBlock>
                                </Border>
                                <Border Style="{StaticResource Chip}" Padding="6,0" Margin="6,0,0,0" Background="#0AFFFFFF" BorderBrush="{StaticResource StrokeSoft}"
                                        Visibility="{Binding IsCritical, Converter={StaticResource Vis}}" ToolTip="{l:T Processes.CriticalTip}">
                                    <TextBlock Text="{l:T Processes.SystemChip}" FontSize="10.5" Foreground="{StaticResource TextDim}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Body}" FontSize="11.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                <Run Text="{Binding ProcessName, Mode=OneWay}" Foreground="{StaticResource TextMute}" /><Run Text="  " /><Run Text="{Binding Company, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Cpu, StringFormat={}{0:0.0} %}" Style="{StaticResource Value}" FontSize="13" />
                            <ProgressBar Grid.Column="1" Style="{StaticResource NeonBar}" Height="4" Value="{Binding Cpu, Mode=OneWay}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Grid.Column="3" Text="{Binding Memory, Converter={StaticResource Bytes}}" Style="{StaticResource Value}" FontSize="13"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="{l:T Processes.OpenLocation}"
                                    Command="{Binding DataContext.RevealCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="{l:T Processes.Kill}" Margin="4,0,0,0" Foreground="{StaticResource Red}"
                                    IsEnabled="{Binding CanKill}" Command="{Binding DataContext.KillCommand, ElementName=Root}" CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource Vis}}">
            <TextBlock Text="{l:T Processes.Loading}" Style="{StaticResource H2}" HorizontalAlignment="Center" />
            <ProgressBar Style="{StaticResource NeonBar}" IsIndeterminate="True" Width="260" Margin="0,16,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
