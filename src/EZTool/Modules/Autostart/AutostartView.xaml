<UserControl x:Class="EZTool.Modules.Autostart.AutostartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:EZTool.Core"
             x:Name="Root">
    <Grid Margin="40,0,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ Kennzahlen ═══ -->
        <UniformGrid Columns="3" Margin="-8,0,-8,16">
            <Border Style="{StaticResource Card}" Margin="8,0" Padding="20,16">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{l:T Autostart.StatEnabled}" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding EnabledCount}" Style="{StaticResource BigValue}" Foreground="{StaticResource Accent}" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="30" HorizontalAlignment="Right" Opacity="0.35" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0" Padding="20,16">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{l:T Autostart.StatDisabled}" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding DisabledCount}" Style="{StaticResource BigValue}" Foreground="{StaticResource TextDim}" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="28" HorizontalAlignment="Right" Foreground="{StaticResource TextDim}" Opacity="0.35" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0" Padding="20,16">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{l:T Autostart.StatBroken}" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding BrokenCount}" Style="{StaticResource BigValue}" Foreground="{StaticResource Amber}" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="28" HorizontalAlignment="Right" Foreground="{StaticResource Amber}" Opacity="0.35" />
                </Grid>
            </Border>
        </UniformGrid>

        <!-- ═══ Werkzeugleiste ═══ -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Border Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="4" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Autostart.FilterAll}" IsChecked="True" GroupName="asf" Command="{Binding SetFilterCommand}" CommandParameter="all" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Autostart.FilterRegistry}" GroupName="asf" Command="{Binding SetFilterCommand}" CommandParameter="registry" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Autostart.FilterFolder}" GroupName="asf" Command="{Binding SetFilterCommand}" CommandParameter="folder" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Autostart.FilterTasks}" GroupName="asf" Command="{Binding SetFilterCommand}" CommandParameter="task" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Autostart.FilterBroken}" GroupName="asf" Command="{Binding SetFilterCommand}" CommandParameter="broken" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding LoadCommand}" ToolTip="{l:T Autostart.Reload}" Margin="8,0,0,0" />
            </StackPanel>
            <TextBox Style="{StaticResource SearchBox}" Width="280" HorizontalAlignment="Right" Tag="{l:T Autostart.SearchPlaceholder}"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- ═══ Liste ═══ -->
        <ListBox Grid.Row="2" Style="{StaticResource CleanList}" ItemsSource="{Binding EntriesView}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid x:Name="row" Height="64" Margin="0,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="84" />
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Grid Width="38" Height="38" HorizontalAlignment="Center">
                            <Border CornerRadius="4" Background="{Binding Name, Converter={StaticResource NameBrush}}">
                                <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                           FontSize="16" Foreground="{StaticResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border CornerRadius="4" Background="{StaticResource PanelHi}" Visibility="{Binding Icon, Converter={StaticResource Vis}}">
                                <Image Source="{Binding Icon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </Grid>

                        <!-- Name, Hersteller, Befehl -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="name" Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                                <Border Style="{StaticResource Chip}" Padding="6,0" Margin="8,0,0,0" Background="#1AFF9F1C" BorderBrush="#55FF9F1C"
                                        Visibility="{Binding FileMissing, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{l:T Autostart.FileMissing}" FontSize="10.5" Foreground="{StaticResource Amber}" />
                                </Border>
                                <Border Style="{StaticResource Chip}" Padding="6,0" Margin="8,0,0,0" Background="#0AFFFFFF" BorderBrush="{StaticResource StrokeSoft}"
                                        Visibility="{Binding IsWindows, Converter={StaticResource Vis}}">
                                    <TextBlock Text="Windows" FontSize="10.5" Foreground="{StaticResource TextDim}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Publisher}" Style="{StaticResource Body}" FontSize="11.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Command}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource TextMute}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Command}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Quelle -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SourceIcon}" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource TextDim}" />
                            <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource Body}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Schalter -->
                        <CheckBox Grid.Column="3" Style="{StaticResource Toggle}" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                                  ToolTip="{l:T Autostart.ToggleTip}" />

                        <!-- Aktionen -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="{l:T Autostart.Reveal}"
                                    Command="{Binding DataContext.RevealCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="{l:T Autostart.DeleteTip}" Margin="4,0,0,0" Foreground="{StaticResource Red}"
                                    Command="{Binding DataContext.DeleteCommand, ElementName=Root}" CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                            <Setter TargetName="row" Property="Opacity" Value="0.55" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource Vis}}">
            <TextBlock Text="{l:T Autostart.Loading}" Style="{StaticResource H2}" HorizontalAlignment="Center" />
            <ProgressBar Style="{StaticResource NeonBar}" IsIndeterminate="True" Width="260" Margin="0,16,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
