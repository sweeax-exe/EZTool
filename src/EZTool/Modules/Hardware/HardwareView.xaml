<UserControl x:Class="EZTool.Modules.Hardware.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,0,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Werkzeugleiste -->
        <Grid Margin="0,0,8,16">
            <Border Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SegmentButton}" Content="Alle" IsChecked="True" Command="{Binding SetFilterCommand}" CommandParameter="all" GroupName="hwf" />
                    <RadioButton Style="{StaticResource SegmentButton}" Content="Temperaturen" Command="{Binding SetFilterCommand}" CommandParameter="temp" GroupName="hwf" />
                    <RadioButton Style="{StaticResource SegmentButton}" Content="Auslastung" Command="{Binding SetFilterCommand}" CommandParameter="load" GroupName="hwf" />
                    <RadioButton Style="{StaticResource SegmentButton}" Content="Takt" Command="{Binding SetFilterCommand}" CommandParameter="clock" GroupName="hwf" />
                    <RadioButton Style="{StaticResource SegmentButton}" Content="Leistung" Command="{Binding SetFilterCommand}" CommandParameter="power" GroupName="hwf" />
                    <RadioButton Style="{StaticResource SegmentButton}" Content="Lüfter" Command="{Binding SetFilterCommand}" CommandParameter="fan" GroupName="hwf" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Run Text="{Binding SensorCount, Mode=OneWay}" Foreground="{StaticResource Cyan}" /><Run Text=" Sensoren live" />
                </TextBlock>
                <TextBox Style="{StaticResource SearchBox}" Width="260" Tag="Sensor suchen…" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <!-- Laden -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource Vis}}">
            <TextBlock Text="Sensoren werden initialisiert…" Style="{StaticResource H2}" HorizontalAlignment="Center" />
            <ProgressBar Style="{StaticResource NeonBar}" IsIndeterminate="True" Width="260" Margin="0,16,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <ItemsControl ItemsSource="{Binding Nodes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding IsVisible, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource CyanSoft}" BorderBrush="#3300E5FF" BorderThickness="1">
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource Label}" Foreground="{StaticResource Cyan}" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" />
                                    </StackPanel>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Groups}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsVisible, Converter={StaticResource Vis}}">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Label}" Margin="2,0,0,8" />
                                                <ItemsControl ItemsSource="{Binding Sensors}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="214" Margin="0,0,10,10" Padding="14,10" CornerRadius="10" Background="#07FFFFFF"
                                                                    BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1"
                                                                    Visibility="{Binding IsVisible, Converter={StaticResource Vis}}" ToolTip="{Binding RangeText}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                                    <TextBlock Text="{Binding ValueText}" Style="{StaticResource Value}" FontSize="18" Margin="0,3,0,0" />
                                                                    <ProgressBar Style="{StaticResource NeonBar}" Height="3" Margin="0,8,0,0" Value="{Binding Percent, Mode=OneWay}"
                                                                                 Visibility="{Binding HasBar, Converter={StaticResource Vis}}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
