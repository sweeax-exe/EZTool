<UserControl x:Class="EZTool.Modules.Updates.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid Margin="40,0,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <Border Style="{StaticResource Card}" Padding="22,16" Margin="0,0,0,14">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="14" Background="{StaticResource CyanSoft}" BorderBrush="#3300E5FF" BorderThickness="1">
                        <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}" Style="{StaticResource H2}" />
                        <TextBlock Style="{StaticResource Body}" FontSize="12">
                            <Run Text="Zuletzt geprüft: " /><Run Text="{Binding LastCheck, Mode=OneWay, StringFormat={}{0:HH:mm} Uhr, TargetNullValue=noch nie}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding CheckCommand}" Padding="14,9" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                            <TextBlock Text="Erneut suchen" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding UpdateSelectedCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                            <TextBlock Margin="10,0,0,0"><Run Text="Ausgewählte aktualisieren (" /><Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,8" Visibility="{Binding HasItems, Converter={StaticResource Vis}}">
            <TextBlock Text="Programme mit neuer Version" Style="{StaticResource Label}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource GhostButton}" Content="Alle" Command="{Binding SelectAllCommand}" Padding="12,5" Margin="0,0,8,0" />
                <Button Style="{StaticResource GhostButton}" Content="Keine" Command="{Binding SelectNoneCommand}" Padding="12,5" />
            </StackPanel>
        </Grid>

        <ListBox Grid.Row="2" Style="{StaticResource CleanList}" ItemsSource="{Binding Items}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="58" Margin="0,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsChecked}" HorizontalAlignment="Center" />
                        <Grid Grid.Column="1" Width="36" Height="36">
                            <Border CornerRadius="10" Background="{Binding Name, Converter={StaticResource NameBrush}}" Opacity="0.9">
                                <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                           FontSize="16" Foreground="#04060C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border CornerRadius="10" Background="#FF101828" Visibility="{Binding Icon, Converter={StaticResource Vis}}">
                                <Image Source="{Binding Icon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,12,0">
                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Id}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource TextMute}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="13" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Version, Mode=OneWay}" Foreground="{StaticResource TextDim}" /><Run Text="  →  " Foreground="{StaticResource TextMute}" /><Run Text="{Binding Available, Mode=OneWay}" Foreground="{StaticResource Cyan}" />
                        </TextBlock>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <TextBlock x:Name="status" Text="{Binding Status}" Style="{StaticResource Body}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Status}" />
                            <ProgressBar Style="{StaticResource NeonBar}" IsIndeterminate="True" Height="3" Margin="0,6,0,0" Visibility="{Binding IsWorking, Converter={StaticResource Vis}}" />
                        </StackPanel>
                        <Button Grid.Column="5" Style="{StaticResource IconButton}" Content="&#xE896;" ToolTip="Jetzt aktualisieren"
                                Command="{Binding DataContext.UpdateOneCommand, ElementName=Root}" CommandParameter="{Binding}" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="1">
                            <Setter TargetName="status" Property="Foreground" Value="{StaticResource Green}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="2">
                            <Setter TargetName="status" Property="Foreground" Value="{StaticResource Red}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsChecking, Converter={StaticResource Vis}}">
            <TextBlock Text="Frage den Windows-Paketmanager…" Style="{StaticResource H2}" HorizontalAlignment="Center" />
            <TextBlock Text="Das kann beim ersten Mal bis zu einer Minute dauern." Style="{StaticResource Body}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            <ProgressBar Style="{StaticResource NeonBar}" IsIndeterminate="True" Width="260" Margin="0,16,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding WingetMissing, Converter={StaticResource Vis}}" BorderBrush="#55FFB547">
            <StackPanel>
                <TextBlock Text="Windows-Paketmanager nicht gefunden" Style="{StaticResource H2}" />
                <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0">
                    Für Updates wird „winget“ benötigt. Installiere den „App Installer“ aus dem Microsoft Store – unter Windows 11 ist er normalerweise schon vorhanden.
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
