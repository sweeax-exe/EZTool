<UserControl x:Class="EZTool.Modules.Security.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EZTool.Controls"
             xmlns:l="clr-namespace:EZTool.Core">
    <UserControl.Resources>
        <Style x:Key="Readout" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="44" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontStretch" Value="Condensed" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="46" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="KeyBar" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="SmallGhost" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- Ampel-Markierung für Prüfpunkte -->
        <Style x:Key="LevelMark" TargetType="Rectangle">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{StaticResource TextMute}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Good"><Setter Property="Fill" Value="{StaticResource Green}" /></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warn"><Setter Property="Fill" Value="{StaticResource Amber}" /></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Bad"><Setter Property="Fill" Value="{StaticResource Red}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Schalterzeile (Schutzfunktionen und ASR-Regeln) -->
        <DataTemplate x:Key="ToggleRow">
            <Border BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,0,0,1" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontSize="13.5" />
                            <Border Style="{StaticResource Chip}" Padding="6,1" Margin="10,0,0,0" BorderBrush="#55FF9F1C"
                                    Visibility="{Binding Strict, Converter={StaticResource Vis}}">
                                <TextBlock Text="{l:T Security.Strict}" Style="{StaticResource Label}" FontSize="11" Foreground="{StaticResource Amber}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Body}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding IsOn}" IsEnabled="{Binding Busy, Converter={StaticResource Not}}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,0,32,32">
        <StackPanel>
            <!-- ═══ Messfeld ═══ -->
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="22,18,22,20">
                        <Border Style="{StaticResource KeyBar}" Background="{StaticResource Accent}" />
                        <TextBlock Text="{l:T Security.Score}" Style="{StaticResource H2}" FontSize="15" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ScoreText}" Style="{StaticResource Readout}" FontSize="64" LineHeight="62" />
                            <TextBlock Text="/ 100" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontStretch="Condensed" Foreground="{StaticResource TextMute}"
                                       VerticalAlignment="Bottom" Margin="6,0,0,6" />
                        </StackPanel>
                        <c:SegmentMeter Height="12" Margin="0,12,0,0" Segments="20" Value="{Binding Score}" Brush="{StaticResource Green}" />
                    </StackPanel>
                    <Border Grid.Column="1" BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0" Padding="22,18,22,20">
                        <StackPanel>
                            <Border Style="{StaticResource KeyBar}" Background="{StaticResource Green}" />
                            <TextBlock Text="{l:T Security.Antivirus}" Style="{StaticResource H2}" FontSize="15" />
                            <TextBlock Text="{Binding AvText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Readout}">
                                        <Setter Property="Foreground" Value="{StaticResource Red}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AvOk}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Green}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding AvDetail}" Style="{StaticResource Label}" Margin="0,12,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0" Padding="22,18,22,20">
                        <StackPanel>
                            <Border Style="{StaticResource KeyBar}" Background="{StaticResource Blue}" />
                            <TextBlock Text="{l:T Security.Signatures}" Style="{StaticResource H2}" FontSize="15" />
                            <TextBlock Text="{Binding SigText}" Style="{StaticResource Readout}" />
                            <TextBlock Text="{Binding SigDetail}" Style="{StaticResource Label}" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0" Padding="22,18,22,20">
                        <StackPanel>
                            <Border Style="{StaticResource KeyBar}" Background="{StaticResource TextDim}" />
                            <TextBlock Text="{l:T Security.LastScan}" Style="{StaticResource H2}" FontSize="15" />
                            <TextBlock Text="{Binding LastScanText}" Style="{StaticResource Readout}" />
                            <TextBlock Text="{Binding LastScanDetail}" Style="{StaticResource Label}" Margin="0,12,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ Reiter ═══ -->
            <Grid Margin="0,16,0,12">
                <Border Style="{StaticResource Chip}" Padding="2" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Security.TabOverview}" GroupName="stab" IsChecked="{Binding IsOverview, Mode=OneWay}" Command="{Binding SetTabCommand}" CommandParameter="overview" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Security.TabScan}" GroupName="stab" IsChecked="{Binding IsScan, Mode=OneWay}" Command="{Binding SetTabCommand}" CommandParameter="scan" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Security.TabHardening}" GroupName="stab" IsChecked="{Binding IsHardening, Mode=OneWay}" Command="{Binding SetTabCommand}" CommandParameter="hardening" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Security.TabSuspects}" GroupName="stab" IsChecked="{Binding IsSuspects, Mode=OneWay}" Command="{Binding SetTabCommand}" CommandParameter="suspects" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Security.TabThreats}" GroupName="stab" IsChecked="{Binding IsThreats, Mode=OneWay}" Command="{Binding SetTabCommand}" CommandParameter="threats" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Command="{Binding RefreshCommand}" IsEnabled="{Binding Loading, Converter={StaticResource Not}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                        <TextBlock Text="{l:T Security.Refresh}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ═══ Übersicht: Sicherheits-Check ═══ -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsOverview, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Text="{l:T Security.ChecksTitle}" Style="{StaticResource H2}" />
                    <TextBlock Text="{l:T Security.ChecksNote}" Style="{StaticResource Body}" FontSize="12" Margin="0,2,0,6" />
                    <ProgressBar Style="{StaticResource NeonBar}" IsIndeterminate="True" Height="6" Margin="0,8,0,0" Visibility="{Binding Loading, Converter={StaticResource Vis}}" />
                    <ItemsControl ItemsSource="{Binding Checks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,0,0,1" Padding="0,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="230" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Style="{StaticResource LevelMark}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{StaticResource Text}" FontSize="13.5" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Body}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <Button Grid.Column="3" Style="{StaticResource SmallGhost}" Content="{l:T Security.Fix}"
                                                Command="{Binding DataContext.OpenCheckCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding HasAction, Converter={StaticResource Vis}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ═══ Scannen ═══ -->
            <StackPanel Visibility="{Binding IsScan, Converter={StaticResource Vis}}">
                <UniformGrid Columns="3" Margin="-8,0">
                    <Border Style="{StaticResource Card}" Margin="8,0">
                        <StackPanel>
                            <TextBlock Text="{l:T Security.QuickScan}" Style="{StaticResource H2}" />
                            <TextBlock Text="{l:T Security.QuickScanText}" Style="{StaticResource Body}" FontSize="12.5" Margin="0,6,0,16" MinHeight="54" />
                            <Button Style="{StaticResource PrimaryButton}" Content="{l:T Security.Start}" HorizontalAlignment="Left" Command="{Binding QuickScanCommand}"
                                    IsEnabled="{Binding Scanning, Converter={StaticResource Not}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0">
                        <StackPanel>
                            <TextBlock Text="{l:T Security.FullScan}" Style="{StaticResource H2}" />
                            <TextBlock Text="{l:T Security.FullScanText}" Style="{StaticResource Body}" FontSize="12.5" Margin="0,6,0,16" MinHeight="54" />
                            <Button Style="{StaticResource GhostButton}" Content="{l:T Security.Start}" HorizontalAlignment="Left" Command="{Binding FullScanCommand}"
                                    IsEnabled="{Binding Scanning, Converter={StaticResource Not}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0">
                        <StackPanel>
                            <TextBlock Text="{l:T Security.CustomScan}" Style="{StaticResource H2}" />
                            <TextBlock Text="{l:T Security.CustomScanText}" Style="{StaticResource Body}" FontSize="12.5" Margin="0,6,0,16" MinHeight="54" />
                            <Button Style="{StaticResource GhostButton}" Content="{l:T Security.PickFolder}" HorizontalAlignment="Left" Command="{Binding CustomScanCommand}"
                                    IsEnabled="{Binding Scanning, Converter={StaticResource Not}}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Laufender Scan / Ergebnis -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding ScanTitle}" Style="{StaticResource H2}" Visibility="{Binding ScanTitle, Converter={StaticResource Vis}}" />
                                <TextBlock Text="{l:T Security.NoScanYet}" Style="{StaticResource Body}" Visibility="{Binding ScanTitle, Converter={StaticResource InvVis}}" />
                            </StackPanel>
                            <Button Style="{StaticResource GhostButton}" Content="{l:T Common.Cancel}" HorizontalAlignment="Right" Command="{Binding CancelScanCommand}"
                                    Visibility="{Binding Scanning, Converter={StaticResource Vis}}" />
                        </Grid>
                        <StackPanel Visibility="{Binding Scanning, Converter={StaticResource Vis}}" Margin="0,12,0,0">
                            <ProgressBar Style="{StaticResource NeonBar}" IsIndeterminate="True" />
                            <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource Label}" Margin="0,8,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding ScanResult}" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="{Binding ScanResult, Converter={StaticResource Vis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Green}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScanFoundThreats}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Red}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="2" Margin="-8,16,-8,0">
                    <Border Style="{StaticResource Card}" Margin="8,0">
                        <StackPanel>
                            <TextBlock Text="{l:T Security.UpdateSignatures}" Style="{StaticResource H2}" />
                            <TextBlock Text="{l:T Security.UpdateSignaturesText}" Style="{StaticResource Body}" FontSize="12.5" Margin="0,6,0,16" />
                            <Button Style="{StaticResource GhostButton}" Content="{l:T Security.UpdateNow}" HorizontalAlignment="Left" Command="{Binding UpdateSignaturesCommand}"
                                    IsEnabled="{Binding Scanning, Converter={StaticResource Not}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0" BorderBrush="#55F0443A">
                        <StackPanel>
                            <TextBlock Text="{l:T Security.OfflineTitle}" Style="{StaticResource H2}" />
                            <TextBlock Text="{l:T Security.OfflineText}" Style="{StaticResource Body}" FontSize="12.5" Margin="0,6,0,16" />
                            <Button Style="{StaticResource GhostButton}" Content="{l:T Security.OfflineStart}" HorizontalAlignment="Left" Command="{Binding OfflineScanCommand}"
                                    IsEnabled="{Binding DefenderActive}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>

            <!-- ═══ Härtung ═══ -->
            <StackPanel Visibility="{Binding IsHardening, Converter={StaticResource Vis}}">
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16" BorderBrush="#55FF9F1C"
                        Visibility="{Binding DefenderActive, Converter={StaticResource InvVis}}">
                    <TextBlock Text="{l:T Security.Hard.NeedsDefender}" Style="{StaticResource Body}" />
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16" BorderBrush="#88F0443A"
                        Visibility="{Binding HardeningMessage, Converter={StaticResource Vis}}">
                    <Grid>
                        <TextBlock Text="{Binding HardeningMessage}" Style="{StaticResource Body}" Foreground="{StaticResource Text}" Margin="0,0,180,0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource SmallGhost}" Content="{l:T Security.OpenWindowsSecurity}" HorizontalAlignment="Right" Command="{Binding OpenWindowsSecurityCommand}" />
                    </Grid>
                </Border>

                <Grid IsEnabled="{Binding DefenderActive}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1.3*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{l:T Security.Hard.Title}" Style="{StaticResource H2}" />
                            <TextBlock Text="{l:T Security.Hard.Note}" Style="{StaticResource Body}" FontSize="12" Margin="0,2,0,4" />
                            <ItemsControl ItemsSource="{Binding Protections}" ItemTemplate="{StaticResource ToggleRow}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{l:T Security.Asr.Title}" Style="{StaticResource H2}" />
                                    <TextBlock Text="{l:T Security.Asr.Note}" Style="{StaticResource Body}" FontSize="12" Margin="0,2,260,4" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Button Style="{StaticResource SmallGhost}" Content="{l:T Security.Asr.AllOff}" Command="{Binding DisableAllAsrCommand}" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="{l:T Security.Asr.Recommended}" Command="{Binding EnableRecommendedCommand}" Padding="12,5" FontSize="12" Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding AsrRules}" ItemTemplate="{StaticResource ToggleRow}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- ═══ Auffälliges ═══ -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsSuspects, Converter={StaticResource Vis}}">
                <StackPanel>
                    <Grid>
                        <StackPanel Margin="0,0,180,0">
                            <TextBlock Text="{l:T Security.SuspectsTitle}" Style="{StaticResource H2}" />
                            <TextBlock Text="{l:T Security.SuspectsNote}" Style="{StaticResource Body}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource GhostButton}" Content="{l:T Security.CheckAgain}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding FindSuspectsCommand}" IsEnabled="{Binding SearchingSuspects, Converter={StaticResource Not}}" />
                    </Grid>
                    <ProgressBar Style="{StaticResource NeonBar}" IsIndeterminate="True" Height="6" Margin="0,14,0,0" Visibility="{Binding SearchingSuspects, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{l:T Security.SuspectsNone}" Style="{StaticResource Body}" Foreground="{StaticResource Green}" Margin="0,16,0,4">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource AllVis}">
                                <Binding Path="SuspectsChecked" />
                                <Binding Path="Suspects.Count" Converter="{StaticResource IsZero}" />
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Suspects}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="24" Height="24" VerticalAlignment="Top" HorizontalAlignment="Left">
                                            <Border CornerRadius="3" Background="{Binding App.Name, Converter={StaticResource NameBrush}}">
                                                <TextBlock Text="{Binding App.Name, Converter={StaticResource Initial}}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="12"
                                                           Foreground="{StaticResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Image Source="{Binding App.Icon}" Width="22" Height="22" Visibility="{Binding App.Icon, Converter={StaticResource Vis}}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding App.Name}" Foreground="{StaticResource Text}" FontSize="13.5" />
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource Label}" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                            <ItemsControl ItemsSource="{Binding Reasons}" Margin="0,6,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Chip}" Padding="6,1" Margin="0,0,6,4">
                                                            <TextBlock Text="{Binding}" Style="{StaticResource Label}" FontSize="11" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{StaticResource SmallGhost}" Content="{l:T Security.CheckWithDefender}"
                                                    Command="{Binding DataContext.CheckFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE838;" Margin="6,0,0,0" ToolTip="{l:T Security.ShowInFolder}"
                                                    Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ═══ Bedrohungen ═══ -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsThreats, Converter={StaticResource Vis}}">
                <StackPanel>
                    <Grid>
                        <StackPanel Margin="0,0,220,0">
                            <TextBlock Text="{l:T Security.ThreatsTitle}" Style="{StaticResource H2}" />
                            <TextBlock Text="{l:T Security.ThreatsNote}" Style="{StaticResource Body}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource DangerButton}" Content="{l:T Security.RemoveStart}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding RemoveThreatsCommand}" Visibility="{Binding HasActiveThreats, Converter={StaticResource Vis}}" />
                    </Grid>
                    <TextBlock Text="{l:T Security.ThreatsNone}" Style="{StaticResource Body}" Foreground="{StaticResource Green}" Margin="0,16,0,4">
                        <TextBlock.Visibility>
                            <Binding Path="Threats.Count" Converter="{StaticResource InvVis}" />
                        </TextBlock.Visibility>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Threats}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="160" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Files}" Style="{StaticResource Label}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Severity}" VerticalAlignment="Top">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Label}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Serious}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Red}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource Label}" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="3" Text="{Binding When}" Style="{StaticResource Label}" VerticalAlignment="Top" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
