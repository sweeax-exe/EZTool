<UserControl x:Class="EZTool.Modules.Cleaner.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EZTool.Controls"
             xmlns:l="clr-namespace:EZTool.Core">
    <Grid Margin="40,0,40,28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ Zusammenfassung ═══ -->
        <Border Style="{StaticResource Card}" VerticalAlignment="Top" Padding="24">
            <StackPanel>
                <TextBlock Text="{l:T Cleaner.SelectedLabel}" Style="{StaticResource Label}" HorizontalAlignment="Center" />
                <Grid Width="240" Height="240" Margin="0,16,0,8">
                    <c:RadialGauge Value="{Binding Progress}" Thickness="9" ArcBrush="{StaticResource AccentGradientDiag}" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SelectedBytes, Converter={StaticResource Bytes}}" Style="{StaticResource BigValue}" FontSize="38"
                                   HorizontalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource Body}" FontSize="12">
                            <Run Text="{Binding SelectedFiles, Mode=OneWay, StringFormat={l:T Cleaner.FilesCount}}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource Chip}" HorizontalAlignment="Center" Visibility="{Binding HasCleaned, Converter={StaticResource Vis}}"
                        Background="#1A2CF5A0" BorderBrush="#552CF5A0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{StaticResource Green}" FontSize="12" />
                        <TextBlock Margin="8,0,0,0" Foreground="{StaticResource Green}" FontFamily="{StaticResource DisplayFont}">
                            <Run Text="{Binding FreedBytes, Mode=OneWay, Converter={StaticResource Bytes}, StringFormat={l:T Cleaner.Freed}}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Status}" Style="{StaticResource Body}" TextAlignment="Center" FontSize="12" MinHeight="34" />

                <Button Style="{StaticResource PrimaryButton}" Command="{Binding CleanCommand}" Margin="0,14,0,0" Padding="22,13">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA99;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" />
                        <TextBlock Text="{l:T Cleaner.CleanNow}" Margin="10,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Command="{Binding ScanCommand}" Margin="0,10,0,0" Padding="16,11">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{l:T Cleaner.Rescan}" Margin="10,0,0,0" />
                    </StackPanel>
                </Button>

                <Rectangle Height="1" Fill="{StaticResource StrokeSoft}" Margin="0,22,0,16" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE83D;" Style="{StaticResource Icon}" Foreground="{StaticResource Green}" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <TextBlock Text="{l:T Cleaner.SafeModeHint}" Style="{StaticResource Body}" FontSize="11.5" Margin="10,0,0,0" Width="260" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ Liste ═══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12">
                <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center">
                    <Run Text="{l:T Cleaner.TotalFound}" /><Run Text="{Binding TotalBytes, Mode=OneWay, Converter={StaticResource Bytes}}" Foreground="{StaticResource Cyan}" FontFamily="{StaticResource DisplayFont}" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="{l:T Cleaner.SelectAll}" Command="{Binding SelectAllCommand}" Padding="12,6" Margin="0,0,8,0" />
                    <Button Style="{StaticResource GhostButton}" Content="{l:T Cleaner.SelectNone}" Command="{Binding SelectNoneCommand}" Padding="12,6" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <ItemsControl ItemsSource="{Binding ItemsView}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" Foreground="{StaticResource Cyan}" Margin="4,14,0,8" FontSize="12" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="row" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,8" CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Margin="14,0,14,0" Background="#0DFFFFFF">
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Value}" FontSize="14" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" FontSize="12" Margin="0,2,0,0" />
                                        <ProgressBar Style="{StaticResource NeonBar}" IsIndeterminate="True" Height="2" Margin="0,8,0,0"
                                                     Visibility="{Binding IsWorking, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="16,0,4,0" MinWidth="110">
                                        <TextBlock Text="{Binding Size, Converter={StaticResource Bytes}}" Style="{StaticResource Value}" FontSize="17" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding State}" Style="{StaticResource Body}" FontSize="11" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                    <Setter TargetName="row" Property="BorderBrush" Value="#5500E5FF" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="row" Property="BorderBrush" Value="#552CF5A0" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
