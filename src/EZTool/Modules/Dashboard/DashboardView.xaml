<UserControl x:Class="EZTool.Modules.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EZTool.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,0,32,32">
        <StackPanel>

            <!-- Hinweis: Treiber fehlt -->
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16" BorderBrush="#55FFB547"
                    Visibility="{Binding ShowDriverHint, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Amber}" />
                    <TextBlock Text="{Binding DriverHint}" Style="{StaticResource Body}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Jetzt installieren" Command="{Binding InstallDriverCommand}" Padding="14,6" FontSize="12.5"
                            Margin="16,0,0,0" Visibility="{Binding CanInstallDriver, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Border>

            <!-- ═══ Reihe 1: Gauges ═══ -->
            <UniformGrid Columns="4" Margin="-8,0">
                <c:GaugeCard Margin="8" Title="Prozessor" Icon="&#xE950;" Caption="{Binding CpuName}"
                             Value="{Binding CpuLoad}" ValueText="{Binding CpuLoadText}" SubText="{Binding CpuTempText}"
                             ArcBrush="{StaticResource AccentGradient}" GlowColor="#00E5FF"
                             Stat1Label="Takt" Stat1Value="{Binding CpuClockText}"
                             Stat2Label="Leistung" Stat2Value="{Binding CpuPowerText}" />
                <c:GaugeCard Margin="8" Title="Grafik" Icon="&#xE7F4;" Caption="{Binding GpuName}"
                             Value="{Binding GpuLoad}" ValueText="{Binding GpuLoadText}" SubText="{Binding GpuTempText}"
                             ArcBrush="{StaticResource HotGradient}" GlowColor="#B04DFF"
                             Stat1Label="VRAM" Stat1Value="{Binding GpuMemText}"
                             Stat2Label="Takt" Stat2Value="{Binding GpuClockText}" />
                <c:GaugeCard Margin="8" Title="Arbeitsspeicher" Icon="&#xE964;" Caption="{Binding RamTotalText}"
                             Value="{Binding RamLoad}" ValueText="{Binding RamLoadText}" SubText="belegt"
                             ArcBrush="{StaticResource GreenGradient}" GlowColor="#2CF5A0"
                             Stat1Label="Belegt" Stat1Value="{Binding RamUsedText}"
                             Stat2Label="Frei" Stat2Value="{Binding RamFreeText}" />
                <c:GaugeCard Margin="8" Title="Systemlaufwerk" Icon="&#xEDA2;" Caption="{Binding SysDriveName}"
                             Value="{Binding SysDriveLoad}" ValueText="{Binding SysDriveLoadText}" SubText="belegt"
                             GlowColor="#FFB547"
                             Stat1Label="Frei" Stat1Value="{Binding SysDriveFreeText}"
                             Stat2Label="Gesamt" Stat2Value="{Binding SysDriveTotalText}">
                    <c:GaugeCard.ArcBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFB547" Offset="0" />
                            <GradientStop Color="#FF3D9A" Offset="1" />
                        </LinearGradientBrush>
                    </c:GaugeCard.ArcBrush>
                </c:GaugeCard>
            </UniformGrid>

            <!-- ═══ Reihe 2: Verlauf + Temperaturen ═══ -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="200" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D2;" Style="{StaticResource Icon}" FontSize="14" />
                                <TextBlock Text="Live-Auslastung · 60 Sekunden" Style="{StaticResource H2}" FontSize="15" Margin="10,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Cyan}" VerticalAlignment="Center" />
                                <TextBlock Text="CPU" Style="{StaticResource Label}" Margin="6,0,14,0" VerticalAlignment="Center" />
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Magenta}" VerticalAlignment="Center" />
                                <TextBlock Text="GPU" Style="{StaticResource Label}" Margin="6,0,14,0" VerticalAlignment="Center" />
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Green}" VerticalAlignment="Center" />
                                <TextBlock Text="RAM" Style="{StaticResource Label}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <c:Sparkline Values="{Binding RamHistory}" Stroke="#2CF5A0" Maximum="100" />
                            <c:Sparkline Values="{Binding GpuHistory}" Stroke="#FF3D9A" Maximum="100" ShowGrid="False" />
                            <c:Sparkline Values="{Binding CpuHistory}" Stroke="#00E5FF" Maximum="100" ShowGrid="False" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9CA;" Style="{StaticResource Icon}" FontSize="14" />
                            <TextBlock Text="Temperaturen" Style="{StaticResource H2}" FontSize="15" Margin="10,0,0,0" />
                        </StackPanel>

                        <Grid Margin="0,22,0,0">
                            <TextBlock Text="CPU" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding CpuTempText}" Style="{StaticResource Value}" HorizontalAlignment="Right"
                                       Foreground="{Binding CpuTemp, Converter={StaticResource TempBrush}}" />
                        </Grid>
                        <ProgressBar Style="{StaticResource NeonBar}" Value="{Binding CpuTemp, Mode=OneWay}" Margin="0,8,0,0"
                                     Foreground="{Binding CpuTemp, Converter={StaticResource TempBrush}}" />

                        <Grid Margin="0,22,0,0">
                            <TextBlock Text="GPU" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding GpuTempText}" Style="{StaticResource Value}" HorizontalAlignment="Right"
                                       Foreground="{Binding GpuTemp, Converter={StaticResource TempBrush}}" />
                        </Grid>
                        <ProgressBar Style="{StaticResource NeonBar}" Value="{Binding GpuTemp, Mode=OneWay}" Margin="0,8,0,0"
                                     Foreground="{Binding GpuTemp, Converter={StaticResource TempBrush}}" />

                        <Grid Margin="0,22,0,0">
                            <TextBlock Text="GPU Hotspot" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding GpuHotSpotText}" Style="{StaticResource Value}" HorizontalAlignment="Right"
                                       Foreground="{Binding GpuHotSpot, Converter={StaticResource TempBrush}}" />
                        </Grid>
                        <ProgressBar Style="{StaticResource NeonBar}" Value="{Binding GpuHotSpot, Mode=OneWay}" Margin="0,8,0,0"
                                     Foreground="{Binding GpuHotSpot, Converter={StaticResource TempBrush}}" />

                        <Grid Margin="0,22,0,0">
                            <StackPanel>
                                <TextBlock Text="GPU-Lüfter" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding GpuFanText}" Style="{StaticResource Value}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="GPU-Leistung" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding GpuPowerText}" Style="{StaticResource Value}" Margin="0,4,0,0" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ Reihe 3: Threads, Laufwerke, Netzwerk ═══ -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Threads -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" FontSize="14" />
                            <TextBlock Text="Kern-Auslastung" Style="{StaticResource H2}" FontSize="15" Margin="10,0,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ThreadLoads}" Margin="0,18,0,0" Height="110">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="1.5,0" ToolTip="{Binding StringFormat={}{0:0} %}">
                                        <Border CornerRadius="3" Background="#0EFFFFFF" />
                                        <Border CornerRadius="3" VerticalAlignment="Bottom" Background="{StaticResource AccentGradientDiag}"
                                                Height="{Binding Converter={StaticResource PctLen}, ConverterParameter=110}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Body}" FontSize="11" Margin="0,10,0,0">
                            <Run Text="{Binding ThreadLoads.Length, Mode=OneWay}" /><Run Text=" logische Prozessoren" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Laufwerke -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="14" />
                            <TextBlock Text="Laufwerke" Style="{StaticResource H2}" FontSize="15" Margin="10,0,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Drives}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,8,0,4">
                                        <Grid>
                                            <TextBlock>
                                                <Run Text="{Binding Letter, Mode=OneWay}" Foreground="{StaticResource Text}" FontFamily="{StaticResource DisplayFont}" FontSize="14" />
                                                <Run Text="{Binding Label, Mode=OneWay}" Foreground="{StaticResource TextDim}" FontSize="12" />
                                            </TextBlock>
                                            <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource TextDim}" FontSize="12">
                                                <Run Text="{Binding Free, Mode=OneWay, Converter={StaticResource Bytes}}" Foreground="{StaticResource Text}" /><Run Text=" frei von " /><Run Text="{Binding Total, Mode=OneWay, Converter={StaticResource Bytes}}" />
                                            </TextBlock>
                                        </Grid>
                                        <ProgressBar Style="{StaticResource NeonBar}" Value="{Binding UsedPercent, Mode=OneWay}" Margin="0,7,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Netzwerk -->
                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8CB;" Style="{StaticResource Icon}" FontSize="14" />
                            <TextBlock Text="Netzwerk" Style="{StaticResource H2}" FontSize="15" Margin="10,0,0,0" />
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="↓ Download" Style="{StaticResource Label}" Foreground="{StaticResource Cyan}" />
                                <TextBlock Text="{Binding NetDownText}" Style="{StaticResource Value}" FontSize="20" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="↑ Upload" Style="{StaticResource Label}" Foreground="{StaticResource Magenta}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding NetUpText}" Style="{StaticResource Value}" FontSize="20" Margin="0,2,0,0" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,14,0,0" MinHeight="70">
                            <c:Sparkline Values="{Binding NetUpHistory}" Stroke="#FF3D9A" Maximum="0" />
                            <c:Sparkline Values="{Binding NetDownHistory}" Stroke="#00E5FF" Maximum="0" ShowGrid="False" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ Reihe 4: Systeminfo ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}" FontSize="14" />
                        <TextBlock Text="System" Style="{StaticResource H2}" FontSize="15" Margin="10,0,0,0" />
                    </StackPanel>
                    <UniformGrid Columns="4" Margin="0,8,0,0">
                        <StackPanel Margin="0,10,16,0">
                            <TextBlock Text="Betriebssystem" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding System.OsName, FallbackValue=—}" Style="{StaticResource Value}" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding System.OsBuild}" Style="{StaticResource Body}" FontSize="11" />
                        </StackPanel>
                        <StackPanel Margin="0,10,16,0">
                            <TextBlock Text="Mainboard" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding System.Motherboard, FallbackValue=—}" Style="{StaticResource Value}" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Body}" FontSize="11"><Run Text="BIOS " /><Run Text="{Binding System.BiosVersion, Mode=OneWay}" /></TextBlock>
                        </StackPanel>
                        <StackPanel Margin="0,10,16,0">
                            <TextBlock Text="Prozessor" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding CpuName}" Style="{StaticResource Value}" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Body}" FontSize="11"><Run Text="{Binding System.Cores, Mode=OneWay}" /><Run Text=" Kerne · " /><Run Text="{Binding System.Threads, Mode=OneWay}" /><Run Text=" Threads" /></TextBlock>
                        </StackPanel>
                        <StackPanel Margin="0,10,16,0">
                            <TextBlock Text="Arbeitsspeicher" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding System.RamInfo, FallbackValue=—}" Style="{StaticResource Value}" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Margin="0,10,16,0">
                            <TextBlock Text="Grafik" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding System.GpuName, FallbackValue=—}" Style="{StaticResource Value}" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Margin="0,10,16,0">
                            <TextBlock Text="Computername" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding System.ComputerName, FallbackValue=—}" Style="{StaticResource Value}" FontSize="13" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,10,16,0">
                            <TextBlock Text="Benutzer" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding System.UserName, FallbackValue=—}" Style="{StaticResource Value}" FontSize="13" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,10,16,0">
                            <TextBlock Text="Laufzeit" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding UptimeText}" Style="{StaticResource Value}" FontSize="13" Margin="0,3,0,0" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
