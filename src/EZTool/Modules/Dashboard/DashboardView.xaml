<UserControl x:Class="EZTool.Modules.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EZTool.Controls"
             xmlns:l="clr-namespace:EZTool.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,0,32,32">
        <StackPanel>

            <!-- Hinweis: Treiber fehlt -->
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16" BorderBrush="#55FF9F1C"
                    Visibility="{Binding ShowDriverHint, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Amber}" />
                    <TextBlock Text="{Binding DriverHint}" Style="{StaticResource Body}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource PrimaryButton}" Content="{l:T Dashboard.InstallNow}" Command="{Binding InstallDriverCommand}" Padding="14,6" FontSize="12.5"
                            Margin="16,0,0,0" Visibility="{Binding CanInstallDriver, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Border>

            <!-- ═══ Reihe 1: Messkanäle – ein durchgehendes Instrumentenfeld ═══ -->
            <Border Style="{StaticResource Card}" Padding="0">
                <UniformGrid Columns="4">
                    <c:GaugeCard Title="{l:T Dashboard.Processor}" Caption="{Binding CpuName}"
                                 Value="{Binding CpuLoad}" ValueText="{Binding CpuLoadText}" SubText="{Binding CpuTempText}"
                                 SubBrush="{Binding CpuTemp, Converter={StaticResource TempBrush}}" ArcBrush="{StaticResource Accent}"
                                 Stat1Label="{l:T Dashboard.Clock}" Stat1Value="{Binding CpuClockText}"
                                 Stat2Label="{l:T Dashboard.Power}" Stat2Value="{Binding CpuPowerText}" />
                    <c:GaugeCard BorderThickness="1,0,0,0" Title="{l:T Dashboard.Graphics}" Caption="{Binding GpuName}"
                                 Value="{Binding GpuLoad}" ValueText="{Binding GpuLoadText}" SubText="{Binding GpuTempText}"
                                 SubBrush="{Binding GpuTemp, Converter={StaticResource TempBrush}}" ArcBrush="{StaticResource Blue}"
                                 Stat1Label="VRAM" Stat1Value="{Binding GpuMemText}"
                                 Stat2Label="{l:T Dashboard.Clock}" Stat2Value="{Binding GpuClockText}" />
                    <c:GaugeCard BorderThickness="1,0,0,0" Title="{l:T Dashboard.Memory}" Caption="{Binding RamTotalText}"
                                 Value="{Binding RamLoad}" ValueText="{Binding RamLoadText}"
                                 ArcBrush="{StaticResource Green}"
                                 Stat1Label="{l:T Dashboard.Used}" Stat1Value="{Binding RamUsedText}"
                                 Stat2Label="{l:T Dashboard.Free}" Stat2Value="{Binding RamFreeText}" />
                    <c:GaugeCard BorderThickness="1,0,0,0" Title="{l:T Dashboard.SystemDrive}" Caption="{Binding SysDriveName}"
                                 Value="{Binding SysDriveLoad}" ValueText="{Binding SysDriveLoadText}"
                                 ArcBrush="{StaticResource TextDim}"
                                 Stat1Label="{l:T Dashboard.Free}" Stat1Value="{Binding SysDriveFreeText}"
                                 Stat2Label="{l:T Dashboard.Total}" Stat2Value="{Binding SysDriveTotalText}" />
                </UniformGrid>
            </Border>

            <!-- ═══ Reihe 2: Verlauf + Temperaturen ═══ -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="200" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D2;" Style="{StaticResource Icon}" FontSize="14" />
                                <TextBlock Text="{l:T Dashboard.LiveLoad}" Style="{StaticResource H2}" FontSize="15" Margin="10,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Rectangle Width="14" Height="4" Fill="{StaticResource Accent}" VerticalAlignment="Center" />
                                <TextBlock Text="CPU" Style="{StaticResource Label}" Margin="6,0,14,0" VerticalAlignment="Center" />
                                <Rectangle Width="14" Height="4" Fill="{StaticResource Blue}" VerticalAlignment="Center" />
                                <TextBlock Text="GPU" Style="{StaticResource Label}" Margin="6,0,14,0" VerticalAlignment="Center" />
                                <Rectangle Width="14" Height="4" Fill="{StaticResource Green}" VerticalAlignment="Center" />
                                <TextBlock Text="RAM" Style="{StaticResource Label}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <c:Sparkline Values="{Binding RamHistory}" Stroke="#6CCB6A" Maximum="100" />
                            <c:Sparkline Values="{Binding GpuHistory}" Stroke="#4DA8E8" Maximum="100" ShowGrid="False" />
                            <c:Sparkline Values="{Binding CpuHistory}" Stroke="#FFC20E" Maximum="100" ShowGrid="False" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9CA;" Style="{StaticResource Icon}" FontSize="14" />
                            <TextBlock Text="{l:T Dashboard.Temperatures}" Style="{StaticResource H2}" FontSize="15" Margin="10,0,0,0" />
                        </StackPanel>

                        <Grid Margin="0,22,0,0">
                            <TextBlock Text="CPU" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding CpuTempText}" Style="{StaticResource Value}" HorizontalAlignment="Right"
                                       Foreground="{Binding CpuTemp, Converter={StaticResource TempBrush}}" />
                        </Grid>
                        <ProgressBar Style="{StaticResource NeonBar}" Value="{Binding CpuTemp, Mode=OneWay}" Margin="0,8,0,0"
                                     Foreground="{Binding CpuTemp, Converter={StaticResource TempBrush}}" />

                        <Grid Margin="0,22,0,0">
                            <TextBlock Text="GPU" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding GpuTempText}" Style="{StaticResource Value}" HorizontalAlignment="Right"
                                       Foreground="{Binding GpuTemp, Converter={StaticResource TempBrush}}" />
                        </Grid>
                        <ProgressBar Style="{StaticResource NeonBar}" Value="{Binding GpuTemp, Mode=OneWay}" Margin="0,8,0,0"
                                     Foreground="{Binding GpuTemp, Converter={StaticResource TempBrush}}" />

                        <Grid Margin="0,22,0,0">
                            <TextBlock Text="{l:T Dashboard.GpuHotspot}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding GpuHotSpotText}" Style="{StaticResource Value}" HorizontalAlignment="Right"
                                       Foreground="{Binding GpuHotSpot, Converter={StaticResource TempBrush}}" />
                        </Grid>
                        <ProgressBar Style="{StaticResource NeonBar}" Value="{Binding GpuHotSpot, Mode=OneWay}" Margin="0,8,0,0"
                                     Foreground="{Binding GpuHotSpot, Converter={StaticResource TempBrush}}" />

                        <Grid Margin="0,22,0,0">
                            <StackPanel>
                                <TextBlock Text="{l:T Dashboard.GpuFan}" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding GpuFanText}" Style="{StaticResource Value}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{l:T Dashboard.GpuPower}" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding GpuPowerText}" Style="{StaticResource Value}" Margin="0,4,0,0" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ Reihe 3: Threads, Laufwerke, Netzwerk ═══ -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Threads -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" FontSize="14" />
                            <TextBlock Text="{l:T Dashboard.CoreLoad}" Style="{StaticResource H2}" FontSize="15" Margin="10,0,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ThreadLoads}" Margin="0,18,0,0" Height="110">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="1.5,0" ToolTip="{Binding StringFormat={}{0:0} %}">
                                        <Border Background="#2E3338" />
                                        <Border VerticalAlignment="Bottom" Background="{StaticResource Accent}"
                                                Height="{Binding Converter={StaticResource PctLen}, ConverterParameter=110}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Body}" FontSize="11" Margin="0,10,0,0">
                            <Run Text="{Binding ThreadLoads.Length, Mode=OneWay, StringFormat={l:T Dashboard.LogicalProcessors}}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Laufwerke -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="14" />
                            <TextBlock Text="{l:T Dashboard.Drives}" Style="{StaticResource H2}" FontSize="15" Margin="10,0,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Drives}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,8,0,4">
                                        <Grid>
                                            <TextBlock>
                                                <Run Text="{Binding Letter, Mode=OneWay}" Foreground="{StaticResource Text}" FontFamily="{StaticResource DisplayFont}" FontSize="14" />
                                                <Run Text="{Binding Label, Mode=OneWay}" Foreground="{StaticResource TextDim}" FontSize="12" />
                                            </TextBlock>
                                            <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource TextDim}" FontSize="12">
                                                <Run Text="{Binding Free, Mode=OneWay, Converter={StaticResource Bytes}}" Foreground="{StaticResource Text}" /><Run Text="{l:T Dashboard.FreeOf}" /><Run Text="{Binding Total, Mode=OneWay, Converter={StaticResource Bytes}}" />
                                            </TextBlock>
                                        </Grid>
                                        <ProgressBar Style="{StaticResource NeonBar}" Value="{Binding UsedPercent, Mode=OneWay}" Margin="0,7,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Netzwerk -->
                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8CB;" Style="{StaticResource Icon}" FontSize="14" />
                            <TextBlock Text="{l:T Dashboard.Network}" Style="{StaticResource H2}" FontSize="15" Margin="10,0,0,0" />
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{l:T Dashboard.Download}" Style="{StaticResource Label}" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="{Binding NetDownText}" Style="{StaticResource Value}" FontSize="20" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{l:T Dashboard.Upload}" Style="{StaticResource Label}" Foreground="{StaticResource Blue}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding NetUpText}" Style="{StaticResource Value}" FontSize="20" Margin="0,2,0,0" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,14,0,0" MinHeight="70">
                            <c:Sparkline Values="{Binding NetUpHistory}" Stroke="#4DA8E8" Maximum="0" />
                            <c:Sparkline Values="{Binding NetDownHistory}" Stroke="#FFC20E" Maximum="0" ShowGrid="False" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ Reihe 4: Systeminfo ═══ -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}" FontSize="14" />
                        <TextBlock Text="{l:T Dashboard.System}" Style="{StaticResource H2}" FontSize="15" Margin="10,0,0,0" />
                    </StackPanel>
                    <UniformGrid Columns="4" Margin="0,8,0,0">
                        <StackPanel Margin="0,10,16,0">
                            <TextBlock Text="{l:T Dashboard.Os}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding System.OsName, FallbackValue=—}" Style="{StaticResource Value}" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding System.OsBuild}" Style="{StaticResource Body}" FontSize="11" />
                        </StackPanel>
                        <StackPanel Margin="0,10,16,0">
                            <TextBlock Text="{l:T Dashboard.Motherboard}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding System.Motherboard, FallbackValue=—}" Style="{StaticResource Value}" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Body}" FontSize="11"><Run Text="BIOS " /><Run Text="{Binding System.BiosVersion, Mode=OneWay}" /></TextBlock>
                        </StackPanel>
                        <StackPanel Margin="0,10,16,0">
                            <TextBlock Text="{l:T Dashboard.Processor}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding CpuName}" Style="{StaticResource Value}" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Body}" FontSize="11"><Run Text="{Binding System.Cores, Mode=OneWay}" /><Run Text="{l:T Dashboard.CoresSuffix}" /><Run Text="{Binding System.Threads, Mode=OneWay}" /><Run Text="{l:T Dashboard.ThreadsSuffix}" /></TextBlock>
                        </StackPanel>
                        <StackPanel Margin="0,10,16,0">
                            <TextBlock Text="{l:T Dashboard.Memory}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding System.RamInfo, FallbackValue=—}" Style="{StaticResource Value}" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Margin="0,10,16,0">
                            <TextBlock Text="{l:T Dashboard.Graphics}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding System.GpuName, FallbackValue=—}" Style="{StaticResource Value}" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Margin="0,10,16,0">
                            <TextBlock Text="{l:T Dashboard.ComputerName}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding System.ComputerName, FallbackValue=—}" Style="{StaticResource Value}" FontSize="13" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,10,16,0">
                            <TextBlock Text="{l:T Dashboard.User}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding System.UserName, FallbackValue=—}" Style="{StaticResource Value}" FontSize="13" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,10,16,0">
                            <TextBlock Text="{l:T Dashboard.Uptime}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding UptimeText}" Style="{StaticResource Value}" FontSize="13" Margin="0,3,0,0" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
