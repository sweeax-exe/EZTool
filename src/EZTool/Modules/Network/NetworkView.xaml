<UserControl x:Class="EZTool.Modules.Network.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EZTool.Controls"
             xmlns:l="clr-namespace:EZTool.Core">
    <UserControl.Resources>
        <Style x:Key="Readout" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="52" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontStretch" Value="Condensed" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="52" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="KeyBar" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="ColHead" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource TextMute}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock" BasedOn="{StaticResource Value}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="SmallGhost" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- Programmsymbol mit Ersatz-Buchstaben -->
        <DataTemplate x:Key="AppIcon">
            <Grid Width="22" Height="22">
                <Border CornerRadius="3" Background="{Binding Name, Converter={StaticResource NameBrush}}">
                    <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Image Source="{Binding Icon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding Icon, Converter={StaticResource Vis}}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,0,32,32">
        <StackPanel>
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16" BorderBrush="#55FF9F1C"
                    Visibility="{Binding Error, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Amber}" />
                    <TextBlock Text="{Binding Error}" Style="{StaticResource Body}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ═══ Messfeld ═══ -->
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="22,18,22,20">
                        <Border Style="{StaticResource KeyBar}" Background="{StaticResource Accent}" />
                        <TextBlock Text="{l:T Network.Download}" Style="{StaticResource H2}" FontSize="15" />
                        <TextBlock Text="{Binding DownText}" Style="{StaticResource Readout}" />
                        <c:SegmentMeter Height="12" Margin="0,12,0,0" Segments="24" Value="{Binding DownMeter}" Brush="{StaticResource Accent}" WarnAt="80" HotAt="94" />
                        <TextBlock Text="{Binding DownBits}" Style="{StaticResource Label}" Margin="0,8,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0" Padding="22,18,22,20">
                        <StackPanel>
                            <Border Style="{StaticResource KeyBar}" Background="{StaticResource Blue}" />
                            <TextBlock Text="{l:T Network.Upload}" Style="{StaticResource H2}" FontSize="15" />
                            <TextBlock Text="{Binding UpText}" Style="{StaticResource Readout}" />
                            <c:SegmentMeter Height="12" Margin="0,12,0,0" Segments="24" Value="{Binding UpMeter}" Brush="{StaticResource Blue}" WarnAt="80" HotAt="94" />
                            <TextBlock Text="{Binding UpBits}" Style="{StaticResource Label}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0" Padding="22,18,22,20">
                        <StackPanel>
                            <Border Style="{StaticResource KeyBar}" Background="{StaticResource TextDim}" />
                            <TextBlock Text="{l:T Network.Today}" Style="{StaticResource H2}" FontSize="15" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding TodayDown}" Style="{StaticResource BigValue}" FontSize="30" />
                                <TextBlock Grid.Row="1" Text="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource Blue}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TodayUp}" Style="{StaticResource BigValue}" FontSize="30" />
                            </Grid>
                            <TextBlock Text="{l:T Network.TodayNote}" Style="{StaticResource Label}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0" Padding="22,18,22,20">
                        <StackPanel>
                            <Border Style="{StaticResource KeyBar}" Background="{StaticResource Green}" />
                            <TextBlock Text="{l:T Network.Connections}" Style="{StaticResource H2}" FontSize="15" />
                            <TextBlock Text="{Binding ConnectionsText}" Style="{StaticResource Readout}" />
                            <TextBlock Text="{Binding ListeningText}" Style="{StaticResource Label}" Margin="0,14,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ Reiter ═══ -->
            <Grid Margin="0,16,0,12">
                <Border Style="{StaticResource Chip}" Padding="2" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Network.TabOverview}" GroupName="ntab" IsChecked="{Binding IsOverview, Mode=OneWay}" Command="{Binding SetTabCommand}" CommandParameter="overview" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Network.TabApps}" GroupName="ntab" IsChecked="{Binding IsApps, Mode=OneWay}" Command="{Binding SetTabCommand}" CommandParameter="apps" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Network.TabConnections}" GroupName="ntab" IsChecked="{Binding IsConnections, Mode=OneWay}" Command="{Binding SetTabCommand}" CommandParameter="connections" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Network.TabDevices}" GroupName="ntab" IsChecked="{Binding IsDevices, Mode=OneWay}" Command="{Binding SetTabCommand}" CommandParameter="devices" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Network.TabAdapters}" GroupName="ntab" IsChecked="{Binding IsAdapters, Mode=OneWay}" Command="{Binding SetTabCommand}" CommandParameter="adapters" />
                    </StackPanel>
                </Border>
                <TextBox Style="{StaticResource SearchBox}" Width="260" HorizontalAlignment="Right" Tag="{l:T Network.Search}"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}">
                    <TextBox.Visibility>
                        <MultiBinding Converter="{StaticResource AnyVis}">
                            <Binding Path="IsApps" />
                            <Binding Path="IsConnections" />
                        </MultiBinding>
                    </TextBox.Visibility>
                </TextBox>
            </Grid>

            <!-- ═══ Übersicht ═══ -->
            <Grid Visibility="{Binding IsOverview, Converter={StaticResource Vis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.9*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="240" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="{l:T Network.LiveTraffic}" Style="{StaticResource H2}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Rectangle Width="14" Height="4" Fill="{StaticResource Accent}" VerticalAlignment="Center" />
                                    <TextBlock Text="{l:T Network.Download}" Style="{StaticResource Label}" Margin="6,0,14,0" VerticalAlignment="Center" />
                                    <Rectangle Width="14" Height="4" Fill="{StaticResource Blue}" VerticalAlignment="Center" />
                                    <TextBlock Text="{l:T Network.Upload}" Style="{StaticResource Label}" Margin="6,0,14,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ChartScale}" Style="{StaticResource Label}" Foreground="{StaticResource TextMute}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                <c:Sparkline Values="{Binding UpHistory}" Stroke="#4DA8E8" Maximum="{Binding ChartMax}" Capacity="60" />
                                <c:Sparkline Values="{Binding DownHistory}" Stroke="#FFC20E" Maximum="{Binding ChartMax}" Capacity="60" ShowGrid="False" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T Network.ActiveNow}" Style="{StaticResource H2}" />
                            <TextBlock Text="{l:T Network.ActiveNowEmpty}" Style="{StaticResource Body}" Margin="0,10,0,0">
                                <TextBlock.Visibility>
                                    <Binding Path="TopApps.Count" Converter="{StaticResource InvVis}" />
                                </TextBlock.Visibility>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding TopApps}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="34">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Content="{Binding App}" ContentTemplate="{StaticResource AppIcon}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                            <TextBlock Grid.Column="1" Text="{Binding App.Name}" Foreground="{StaticResource Text}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource Cell}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"
                                                       Visibility="{Binding RateDown, Converter={StaticResource Vis}}">
                                                <Run Text="↓ " /><Run Text="{Binding RateDown, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="3" Style="{StaticResource Cell}" HorizontalAlignment="Right" Foreground="{StaticResource Blue}"
                                                       Visibility="{Binding RateUp, Converter={StaticResource Vis}}">
                                                <Run Text="↑ " /><Run Text="{Binding RateUp, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{l:T Network.YourConnection}" Style="{StaticResource H2}" />
                        <ItemsControl ItemsSource="{Binding Link}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Value}" FontSize="13" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:T Network.PublicIp}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource SmallGhost}" Content="{l:T Network.ShowPublicIp}" HorizontalAlignment="Left"
                                    Command="{Binding ShowPublicIpCommand}" Visibility="{Binding PublicIp, Converter={StaticResource InvVis}}" />
                            <TextBlock Grid.Column="1" Text="{Binding PublicIp}" Style="{StaticResource Value}" FontSize="13"
                                       Visibility="{Binding PublicIp, Converter={StaticResource Vis}}" />
                        </Grid>
                        <TextBlock Text="{l:T Network.PublicIpNote}" Style="{StaticResource Body}" FontSize="11.5" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ Apps ═══ -->
            <Border Style="{StaticResource Card}" Padding="20,18,12,12" Visibility="{Binding IsApps, Converter={StaticResource Vis}}">
                <StackPanel>
                    <Grid Margin="0,0,8,6">
                        <StackPanel>
                            <TextBlock Text="{l:T Network.AppsTitle}" Style="{StaticResource H2}" />
                            <TextBlock Text="{l:T Network.AppsNote}" Style="{StaticResource Body}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Style="{StaticResource Chip}" Padding="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Network.RangeToday}" GroupName="nrange" Padding="10,4" Command="{Binding SetUsageDaysCommand}" CommandParameter="1"
                                             IsChecked="{Binding UsageDays, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=1}" />
                                <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Network.Range7}" GroupName="nrange" Padding="10,4" Command="{Binding SetUsageDaysCommand}" CommandParameter="7"
                                             IsChecked="{Binding UsageDays, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=7}" />
                                <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Network.Range30}" GroupName="nrange" Padding="10,4" Command="{Binding SetUsageDaysCommand}" CommandParameter="30"
                                             IsChecked="{Binding UsageDays, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=30}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Margin="8,10,24,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{l:T Network.ColApp}" Style="{StaticResource ColHead}" />
                        <TextBlock Grid.Column="2" Text="{l:T Network.ColNowDown}" Style="{StaticResource ColHead}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="{l:T Network.ColNowUp}" Style="{StaticResource ColHead}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{l:T Network.ColPeriodDown}" Style="{StaticResource ColHead}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="{l:T Network.ColPeriodUp}" Style="{StaticResource ColHead}" HorizontalAlignment="Right" />
                    </Grid>
                    <ListBox Style="{StaticResource CleanList}" ItemsSource="{Binding Apps}" Height="560">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="40" Margin="8,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{Binding App}" ContentTemplate="{StaticResource AppIcon}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding App.Name}" Foreground="{StaticResource Text}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding App.Path}" Style="{StaticResource Label}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding App.Path}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding RateDown}" Style="{StaticResource Cell}" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{Binding RateUp}" Style="{StaticResource Cell}" Foreground="{StaticResource Blue}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{Binding PeriodDown}" Style="{StaticResource Cell}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="{Binding PeriodUp}" Style="{StaticResource Cell}" HorizontalAlignment="Right" />
                                    <ProgressBar Grid.Column="6" Style="{StaticResource NeonBar}" Height="6" Margin="18,0,0,0" Value="{Binding Share, Mode=OneWay}" Foreground="{StaticResource TextDim}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- ═══ Verbindungen ═══ -->
            <StackPanel Visibility="{Binding IsConnections, Converter={StaticResource Vis}}">
                <Border Style="{StaticResource Card}" Padding="20,18,12,12">
                    <StackPanel>
                        <Grid Margin="0,0,8,6">
                            <StackPanel>
                                <TextBlock Text="{l:T Network.ConnTitle}" Style="{StaticResource H2}" />
                                <TextBlock Text="{l:T Network.ConnNote}" Style="{StaticResource Body}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Style="{StaticResource Chip}" Padding="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Network.OnlyActive}" GroupName="nconn" Padding="10,4"
                                                 IsChecked="{Binding OnlyActive, Mode=OneWay}" Command="{Binding SetOnlyActiveCommand}" CommandParameter="True" />
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Network.AllConnections}" GroupName="nconn" Padding="10,4"
                                                 IsChecked="{Binding OnlyActive, Mode=OneWay, Converter={StaticResource Not}}" Command="{Binding SetOnlyActiveCommand}" CommandParameter="False" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="8,10,24,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="84" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="{l:T Network.ColApp}" Style="{StaticResource ColHead}" />
                            <TextBlock Grid.Column="2" Text="{l:T Network.ColRemote}" Style="{StaticResource ColHead}" />
                            <TextBlock Grid.Column="3" Text="{l:T Network.ColProto}" Style="{StaticResource ColHead}" />
                            <TextBlock Grid.Column="4" Text="{l:T Network.ColState}" Style="{StaticResource ColHead}" />
                            <TextBlock Grid.Column="5" Text="↓" Style="{StaticResource ColHead}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="6" Text="↑" Style="{StaticResource ColHead}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="7" Text="{l:T Network.ColTotal}" Style="{StaticResource ColHead}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{l:T Network.ConnEmpty}" Style="{StaticResource Body}" Margin="8,16,0,24">
                            <TextBlock.Visibility>
                                <Binding Path="Connections.Count" Converter="{StaticResource InvVis}" />
                            </TextBlock.Visibility>
                        </TextBlock>
                        <ListBox Style="{StaticResource CleanList}" ItemsSource="{Binding Connections}" Height="480">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="40" Margin="8,0,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="84" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Content="{Binding App}" ContentTemplate="{StaticResource AppIcon}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="1" Text="{Binding App.Name}" Foreground="{StaticResource Text}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Host}" Foreground="{StaticResource Text}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Host}"
                                                       Visibility="{Binding Host, Converter={StaticResource Vis}}" />
                                            <TextBlock Text="{Binding Address}" Style="{StaticResource Label}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding Protocol}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding State}" Style="{StaticResource Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="5" Text="{Binding RateDown}" Style="{StaticResource Cell}" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="6" Text="{Binding RateUp}" Style="{StaticResource Cell}" Foreground="{StaticResource Blue}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="7" Text="{Binding Total}" Style="{StaticResource Cell}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{l:T Network.PortsTitle}" Style="{StaticResource H2}" />
                        <TextBlock Text="{l:T Network.PortsNote}" Style="{StaticResource Body}" FontSize="12" Margin="0,2,0,8" MaxWidth="900" HorizontalAlignment="Left" />
                        <ItemsControl ItemsSource="{Binding Ports}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Protocol}" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Port}" Style="{StaticResource Cell}" FontSize="14" />
                                        <ContentPresenter Grid.Column="2" Content="{Binding App}" ContentTemplate="{StaticResource AppIcon}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="3" Text="{Binding App.Name}" Foreground="{StaticResource Text}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Text="{Binding Scope}" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Label}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Exposed}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══ Geräte ═══ -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsDevices, Converter={StaticResource Vis}}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{l:T Network.DevicesTitle}" Style="{StaticResource H2}" />
                            <TextBlock Text="{l:T Network.DevicesNote}" Style="{StaticResource Body}" FontSize="12" Margin="0,2,0,0" MaxWidth="760" HorizontalAlignment="Left" />
                        </StackPanel>
                        <Grid HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" Visibility="{Binding IsScanning, Converter={StaticResource InvVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                                    <TextBlock Text="{l:T Network.Scan}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Content="{l:T Common.Cancel}" Command="{Binding ScanCommand}" Visibility="{Binding IsScanning, Converter={StaticResource Vis}}" />
                        </Grid>
                    </Grid>
                    <ProgressBar Style="{StaticResource NeonBar}" Margin="0,16,0,0" Value="{Binding ScanProgress, Mode=OneWay}" Visibility="{Binding IsScanning, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding ScanSummary}" Style="{StaticResource Label}" Margin="0,14,0,0" Visibility="{Binding ScanSummary, Converter={StaticResource Vis}}" />
                    <ItemsControl ItemsSource="{Binding Devices}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="230" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="16" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                    <Setter Property="Text" Value="&#xE772;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRouter}" Value="True">
                                                            <Setter Property="Text" Value="&#xE839;" />
                                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                            <Setter Property="Text" Value="&#xE7F4;" />
                                                            <Setter Property="Foreground" Value="{StaticResource Green}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{l:T Network.Router}" Style="{StaticResource Label}" FontSize="11" Foreground="{StaticResource Accent}"
                                                           Visibility="{Binding IsRouter, Converter={StaticResource Vis}}" />
                                                <TextBlock Text="{l:T Network.ThisPc}" Style="{StaticResource Label}" FontSize="11" Foreground="{StaticResource Green}"
                                                           Visibility="{Binding IsSelf, Converter={StaticResource Vis}}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Ip}" Style="{StaticResource Cell}" FontSize="13" />
                                        <TextBlock Grid.Column="3" Text="{Binding Mac}" Style="{StaticResource Cell}" Foreground="{StaticResource TextDim}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Vendor}" Style="{StaticResource Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Vendor}" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="5" Text="{Binding Ping}" Style="{StaticResource Label}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ═══ Adapter ═══ -->
            <ItemsControl ItemsSource="{Binding Adapters}" Visibility="{Binding IsAdapters, Converter={StaticResource Vis}}" Margin="-8,-8,-8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="8">
                            <StackPanel>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource KeyBar}">
                                            <Setter Property="Background" Value="{StaticResource TextMute}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUp}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Green}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Label}" Margin="0,2,0,6" TextTrimming="CharacterEllipsis" />
                                <ItemsControl ItemsSource="{Binding Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Value}" FontSize="12.5" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
