<UserControl x:Class="EZTool.Modules.Tweaks.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:EZTool.Core">
    <Grid Margin="40,0,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Werkzeugleiste -->
        <Grid Margin="0,0,0,12">
            <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center">
                <Run Text="{Binding ActiveCount, Mode=OneWay}" Foreground="{StaticResource Cyan}" FontFamily="{StaticResource DisplayFont}" /><Run Text="{l:T Tweaks.ActiveSuffix}" />
            </TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource GhostButton}" Command="{Binding CreateRestorePointCommand}" Padding="14,8" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE83D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Foreground="{StaticResource Green}" />
                        <TextBlock Text="{l:T Tweaks.RestorePoint}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Content="{l:T Tweaks.ResetAll}" Command="{Binding ResetAllCommand}" Padding="14,8" />
            </StackPanel>
        </Grid>

        <!-- Hinweis: Neustart nötig -->
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,12" BorderBrush="#5500E5FF"
                    Visibility="{Binding NeedsExplorerRestart, Converter={StaticResource Vis}}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" />
                        <TextBlock Text="{l:T Tweaks.ExplorerRestartHint}" Style="{StaticResource Body}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryButton}" Content="{l:T Tweaks.RestartExplorer}" Command="{Binding RestartExplorerCommand}" HorizontalAlignment="Right" Padding="14,7" FontSize="12.5" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12" BorderBrush="#55FFB547"
                    Visibility="{Binding NeedsReboot, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Amber}" />
                    <TextBlock Text="{l:T Tweaks.RebootHint}" Style="{StaticResource Body}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <ItemsControl ItemsSource="{Binding ItemsView}">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" Foreground="{StaticResource Cyan}" Margin="4,10,0,8" FontSize="12" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <!-- Bei Gruppierung gilt das ItemsPanel für die Einträge innerhalb jeder Gruppe -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="card" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,10,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="10" Background="#0DFFFFFF" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Value}" FontSize="13.5" TextWrapping="Wrap" />
                                        <Border Style="{StaticResource Chip}" Padding="6,0" Margin="8,0,0,0" Background="#0AFFFFFF" BorderBrush="{StaticResource StrokeSoft}"
                                                Visibility="{Binding NeedsText, Converter={StaticResource Vis}}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NeedsText}" FontSize="10" Foreground="{StaticResource TextDim}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" FontSize="12" Margin="0,3,0,0" />
                                    <TextBlock Text="{l:T Tweaks.RequiresAdmin}" FontSize="11" Foreground="{StaticResource Amber}" Margin="0,4,0,0"
                                               Visibility="{Binding IsLocked, Converter={StaticResource Vis}}" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource Toggle}" IsChecked="{Binding IsOn}" VerticalAlignment="Center"
                                          IsEnabled="{Binding IsLocked, Converter={StaticResource Not}}" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="#5500E5FF" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
