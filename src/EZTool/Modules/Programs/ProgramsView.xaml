<UserControl x:Class="EZTool.Modules.Programs.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <!-- gemeinsame Spaltenbreiten für Kopf und Zeilen -->
        <GridLength x:Key="ColCheck">44</GridLength>
        <GridLength x:Key="ColIcon">52</GridLength>
        <GridLength x:Key="ColVersion">140</GridLength>
        <GridLength x:Key="ColDate">130</GridLength>
        <GridLength x:Key="ColSize">110</GridLength>
        <GridLength x:Key="ColActions">120</GridLength>
    </UserControl.Resources>

    <Grid Margin="40,0,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Werkzeugleiste ═══ -->
        <Grid Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBox Style="{StaticResource SearchBox}" Width="300" Tag="Programm oder Hersteller suchen…"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                <Border Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="10" Padding="3" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" Content="Name" IsChecked="True" GroupName="psort" Command="{Binding SetSortCommand}" CommandParameter="name" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="Größe" GroupName="psort" Command="{Binding SetSortCommand}" CommandParameter="size" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="Neueste" GroupName="psort" Command="{Binding SetSortCommand}" CommandParameter="date" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="10" Padding="3" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" Content="Alle" IsChecked="True" GroupName="pkind" Command="{Binding SetKindCommand}" CommandParameter="all" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="Desktop" GroupName="pkind" Command="{Binding SetKindCommand}" CommandParameter="desktop" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="Store-Apps" GroupName="pkind" Command="{Binding SetKindCommand}" CommandParameter="store" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding LoadCommand}" ToolTip="Liste neu laden" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding QuietMode}" Content="Stille Deinstallation" VerticalAlignment="Center"
                          ToolTip="Nutzt – wenn vom Hersteller angeboten – die Deinstallation ohne Assistent." />
            </StackPanel>
        </Grid>

        <!-- ═══ Tabellenkopf ═══ -->
        <Grid Grid.Row="1" Margin="0,0,14,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource ColCheck}" />
                <ColumnDefinition Width="{StaticResource ColIcon}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource ColVersion}" />
                <ColumnDefinition Width="{StaticResource ColDate}" />
                <ColumnDefinition Width="{StaticResource ColSize}" />
                <ColumnDefinition Width="{StaticResource ColActions}" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="2" Style="{StaticResource Label}">
                <Run Text="{Binding Count, Mode=OneWay}" /><Run Text=" Programme · " /><Run Text="{Binding TotalSize, Mode=OneWay, Converter={StaticResource Bytes}}" />
            </TextBlock>
            <TextBlock Grid.Column="3" Text="Version" Style="{StaticResource Label}" />
            <TextBlock Grid.Column="4" Text="Installiert" Style="{StaticResource Label}" />
            <TextBlock Grid.Column="5" Text="Größe" Style="{StaticResource Label}" HorizontalAlignment="Right" />
        </Grid>

        <!-- ═══ Liste ═══ -->
        <ListBox Grid.Row="2" Style="{StaticResource CleanList}" ItemsSource="{Binding ProgramsView}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="58" Margin="0,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource ColCheck}" />
                            <ColumnDefinition Width="{StaticResource ColIcon}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource ColVersion}" />
                            <ColumnDefinition Width="{StaticResource ColDate}" />
                            <ColumnDefinition Width="{StaticResource ColSize}" />
                            <ColumnDefinition Width="{StaticResource ColActions}" />
                        </Grid.ColumnDefinitions>

                        <CheckBox IsChecked="{Binding IsChecked}" HorizontalAlignment="Center" IsEnabled="{Binding CanUninstall}" />

                        <Grid Grid.Column="1" Width="36" Height="36">
                            <Border CornerRadius="10" Background="{Binding Name, Converter={StaticResource NameBrush}}" Opacity="0.9">
                                <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                           FontSize="16" Foreground="#04060C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border CornerRadius="10" Background="#FF101828" Visibility="{Binding Icon, Converter={StaticResource Vis}}">
                                <Image Source="{Binding Icon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,12,0">
                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding Publisher}" Style="{StaticResource Body}" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="320" TextWrapping="NoWrap" />
                                <Border Style="{StaticResource Chip}" Padding="5,0" Margin="8,0,0,0" Background="#0AFFFFFF" BorderBrush="{StaticResource StrokeSoft}">
                                    <TextBlock Text="{Binding Scope}" FontSize="10" Foreground="{StaticResource TextMute}" />
                                </Border>
                                <Border Style="{StaticResource Chip}" Padding="5,0" Margin="6,0,0,0" Background="#14FFB547" BorderBrush="#44FFB547"
                                        Visibility="{Binding IsProtected, Converter={StaticResource Vis}}" ToolTip="Wird von Windows benötigt und daher nicht zum Entfernen angeboten.">
                                    <TextBlock Text="Systemrelevant" FontSize="10" Foreground="{StaticResource Amber}" />
                                </Border>
                                <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{StaticResource Amber}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Column="3" Text="{Binding Version}" Style="{StaticResource Body}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Grid.Column="4" Text="{Binding InstallDate, StringFormat={}{0:dd.MM.yyyy}, TargetNullValue=—}" Style="{StaticResource Body}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="{Binding Size, Converter={StaticResource Bytes}, ConverterParameter=dash}" Style="{StaticResource Value}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />

                        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Installationsordner öffnen"
                                    Command="{Binding DataContext.OpenLocationCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Deinstallieren" Margin="4,0,0,0" Foreground="{StaticResource Red}" IsEnabled="{Binding CanUninstall}"
                                    Command="{Binding DataContext.UninstallOneCommand, ElementName=Root}" CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Laden -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource Vis}}">
            <TextBlock Text="Installierte Programme werden gelesen…" Style="{StaticResource H2}" HorizontalAlignment="Center" />
            <ProgressBar Style="{StaticResource NeonBar}" IsIndeterminate="True" Width="260" Margin="0,16,0,0" />
        </StackPanel>

        <!-- ═══ Aktionsleiste (nur bei Auswahl) ═══ -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="18,12" Margin="0,14,0,0"
                Visibility="{Binding SelectedCount, Converter={StaticResource Vis}}" BorderBrush="#55FF3D9A">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{StaticResource Magenta}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Text}" FontFamily="{StaticResource DisplayFont}" FontSize="14">
                        <Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=" ausgewählt · " /><Run Text="{Binding SelectedSize, Mode=OneWay, Converter={StaticResource Bytes}}" Foreground="{StaticResource Magenta}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="Auswahl aufheben" Command="{Binding ClearSelectionCommand}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource DangerButton}" Command="{Binding UninstallSelectedCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                            <TextBlock Text="Ausgewählte deinstallieren" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Overlay während Deinstallation ═══ -->
        <Grid Grid.RowSpan="4" Visibility="{Binding IsUninstalling, Converter={StaticResource Vis}}" Background="#B004060C">
            <Border Style="{StaticResource Card}" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
                <StackPanel>
                    <TextBlock Text="DEINSTALLATION LÄUFT" Style="{StaticResource Label}" Foreground="{StaticResource Magenta}" />
                    <TextBlock Text="{Binding CurrentName}" Style="{StaticResource H2}" FontSize="20" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding QueueText}" Style="{StaticResource Body}" Margin="0,6,0,0" />
                    <ProgressBar Style="{StaticResource NeonBar}" IsIndeterminate="True" Foreground="{StaticResource HotGradient}" Margin="0,18,0,0" />
                    <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,16,0,0">
                        Folge den Anweisungen im Fenster des Herstellers. EZTool wartet, bis das Programm wirklich entfernt ist.
                    </TextBlock>
                    <Button Style="{StaticResource GhostButton}" Content="Überspringen" Command="{Binding SkipCurrentCommand}" HorizontalAlignment="Right" Margin="0,18,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
