<UserControl x:Class="EZTool.Modules.Programs.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:EZTool.Core"
             x:Name="Root">
    <UserControl.Resources>
        <!-- gemeinsame Spaltenbreiten für Kopf und Zeilen -->
        <GridLength x:Key="ColCheck">44</GridLength>
        <GridLength x:Key="ColIcon">52</GridLength>
        <GridLength x:Key="ColVersion">140</GridLength>
        <GridLength x:Key="ColDate">130</GridLength>
        <GridLength x:Key="ColSize">110</GridLength>
        <GridLength x:Key="ColActions">120</GridLength>
    </UserControl.Resources>

    <Grid Margin="40,0,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Werkzeugleiste ═══ -->
        <Grid Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBox Style="{StaticResource SearchBox}" Width="300" Tag="{l:T Programs.SearchPlaceholder}"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                <Border Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="4" Padding="3" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Programs.SortName}" IsChecked="True" GroupName="psort" Command="{Binding SetSortCommand}" CommandParameter="name" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Programs.SortSize}" GroupName="psort" Command="{Binding SetSortCommand}" CommandParameter="size" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Programs.SortNewest}" GroupName="psort" Command="{Binding SetSortCommand}" CommandParameter="date" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="4" Padding="3" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Programs.KindAll}" IsChecked="True" GroupName="pkind" Command="{Binding SetKindCommand}" CommandParameter="all" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Programs.KindDesktop}" GroupName="pkind" Command="{Binding SetKindCommand}" CommandParameter="desktop" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T Programs.KindStore}" GroupName="pkind" Command="{Binding SetKindCommand}" CommandParameter="store" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding LoadCommand}" ToolTip="{l:T Programs.Reload}" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding QuietMode}" Content="{l:T Programs.QuietMode}" VerticalAlignment="Center"
                          ToolTip="{l:T Programs.QuietModeTip}" />
            </StackPanel>
        </Grid>

        <!-- ═══ Tabellenkopf ═══ -->
        <Grid Grid.Row="1" Margin="0,0,14,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource ColCheck}" />
                <ColumnDefinition Width="{StaticResource ColIcon}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource ColVersion}" />
                <ColumnDefinition Width="{StaticResource ColDate}" />
                <ColumnDefinition Width="{StaticResource ColSize}" />
                <ColumnDefinition Width="{StaticResource ColActions}" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="2" Style="{StaticResource Label}">
                <Run Text="{Binding Count, Mode=OneWay}" /><Run Text="{l:T Programs.CountSuffix}" /><Run Text="{Binding TotalSize, Mode=OneWay, Converter={StaticResource Bytes}}" />
            </TextBlock>
            <TextBlock Grid.Column="3" Text="{l:T Programs.ColVersion}" Style="{StaticResource Label}" />
            <TextBlock Grid.Column="4" Text="{l:T Programs.ColInstalled}" Style="{StaticResource Label}" />
            <TextBlock Grid.Column="5" Text="{l:T Programs.ColSize}" Style="{StaticResource Label}" HorizontalAlignment="Right" />
        </Grid>

        <!-- ═══ Liste ═══ -->
        <ListBox Grid.Row="2" Style="{StaticResource CleanList}" ItemsSource="{Binding ProgramsView}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="58" Margin="0,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource ColCheck}" />
                            <ColumnDefinition Width="{StaticResource ColIcon}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource ColVersion}" />
                            <ColumnDefinition Width="{StaticResource ColDate}" />
                            <ColumnDefinition Width="{StaticResource ColSize}" />
                            <ColumnDefinition Width="{StaticResource ColActions}" />
                        </Grid.ColumnDefinitions>

                        <CheckBox IsChecked="{Binding IsChecked}" HorizontalAlignment="Center" IsEnabled="{Binding CanUninstall}" />

                        <Grid Grid.Column="1" Width="36" Height="36">
                            <Border CornerRadius="4" Background="{Binding Name, Converter={StaticResource NameBrush}}">
                                <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                           FontSize="16" Foreground="{StaticResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border CornerRadius="4" Background="{StaticResource PanelHi}" Visibility="{Binding Icon, Converter={StaticResource Vis}}">
                                <Image Source="{Binding Icon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,12,0">
                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding Publisher}" Style="{StaticResource Body}" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="320" TextWrapping="NoWrap" />
                                <Border Style="{StaticResource Chip}" Padding="5,0" Margin="8,0,0,0" Background="#0AFFFFFF" BorderBrush="{StaticResource StrokeSoft}">
                                    <TextBlock Text="{Binding Scope}" FontSize="10" Foreground="{StaticResource TextMute}" />
                                </Border>
                                <Border Style="{StaticResource Chip}" Padding="5,0" Margin="6,0,0,0" Background="#14FF9F1C" BorderBrush="#44FF9F1C"
                                        Visibility="{Binding IsProtected, Converter={StaticResource Vis}}" ToolTip="{l:T Programs.ProtectedTip}">
                                    <TextBlock Text="{l:T Programs.Protected}" FontSize="10" Foreground="{StaticResource Amber}" />
                                </Border>
                                <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{StaticResource Amber}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Column="3" Text="{Binding Version}" Style="{StaticResource Body}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Grid.Column="4" Text="{Binding InstallDate, StringFormat={l:T Programs.DateFormat}, TargetNullValue=—}" Style="{StaticResource Body}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="{Binding Size, Converter={StaticResource Bytes}, ConverterParameter=dash}" Style="{StaticResource Value}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" />

                        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="{l:T Programs.OpenFolder}"
                                    Command="{Binding DataContext.OpenLocationCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="{l:T Programs.Uninstall}" Margin="4,0,0,0" Foreground="{StaticResource Red}" IsEnabled="{Binding CanUninstall}"
                                    Command="{Binding DataContext.UninstallOneCommand, ElementName=Root}" CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Laden -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource Vis}}">
            <TextBlock Text="{l:T Programs.Loading}" Style="{StaticResource H2}" HorizontalAlignment="Center" />
            <ProgressBar Style="{StaticResource NeonBar}" IsIndeterminate="True" Width="260" Margin="0,16,0,0" />
        </StackPanel>

        <!-- ═══ Aktionsleiste (nur bei Auswahl) ═══ -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="18,12" Margin="0,14,0,0"
                Visibility="{Binding SelectedCount, Converter={StaticResource Vis}}" BorderBrush="#554DA8E8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{StaticResource Blue}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Text}" FontFamily="{StaticResource DisplayFont}" FontSize="14">
                        <Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text="{l:T Programs.SelectedSuffix}" /><Run Text="{Binding SelectedSize, Mode=OneWay, Converter={StaticResource Bytes}}" Foreground="{StaticResource Blue}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="{l:T Programs.ClearSelection}" Command="{Binding ClearSelectionCommand}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource DangerButton}" Command="{Binding UninstallSelectedCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T Programs.UninstallSelected}" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Overlay während Deinstallation ═══ -->
        <Grid Grid.RowSpan="4" Visibility="{Binding IsUninstalling, Converter={StaticResource Vis}}" Background="#D91F2225">
            <Border Style="{StaticResource Card}" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
                <StackPanel>
                    <TextBlock Text="{l:T Programs.UninstallRunning}" Style="{StaticResource Label}" Foreground="{StaticResource Blue}" />
                    <TextBlock Text="{Binding CurrentName}" Style="{StaticResource H2}" FontSize="20" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding QueueText}" Style="{StaticResource Body}" Margin="0,6,0,0" />
                    <ProgressBar Style="{StaticResource NeonBar}" IsIndeterminate="True" Foreground="{StaticResource Blue}" Margin="0,18,0,0" />
                    <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,16,0,0" Text="{l:T Programs.UninstallHint}" />
                    <Button Style="{StaticResource GhostButton}" Content="{l:T Programs.Skip}" Command="{Binding SkipCurrentCommand}" HorizontalAlignment="Right" Margin="0,18,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
